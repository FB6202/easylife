    color: var(--color-text-muted);
    margin-top: 2px;
  }

  &__close {
    @include btn-ghost;
    border-radius: $radius-md;
    padding: $space-1;
    flex-shrink: 0;

    .material-symbols-outlined {
      font-size: 22px;
    }
  }

  &__action-btn {
    width: 36px;
    height: 36px;
    border-radius: $radius-md;
    border: none;
    @include flex-center;
    cursor: pointer;
    transition: all $transition-fast;

    .material-symbols-outlined {
      font-size: 18px;
    }

    &--download {
      background: var(--color-info-subtle);
      color: var(--color-info);

      &:hover {
        background: var(--color-info-subtle);
        filter: brightness(0.9);
      }
    }

    &--delete {
      background: var(--color-danger-subtle);
      color: var(--color-danger);

      &:hover {
        background: var(--color-danger-subtle);
        filter: brightness(0.9);
      }
    }
  }

  &__file-input {
    display: none;
  }

  &__file-info {
    @include flex-start;
    gap: $space-4;
    padding: $space-4;
    background: var(--color-bg-input);
    border-radius: $radius-md;
  }

  &__file-icon {
    .material-symbols-outlined {
      font-size: 36px;
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
  }

  &__file-type {
    font-size: $font-size-sm;
    font-weight: $font-weight-semibold;
    color: var(--color-text-primary);
  }

  &__file-meta {
    font-size: $font-size-xs;
    color: var(--color-text-muted);
    margin-top: 2px;
  }

  &__footer {
    @include flex-between;
    padding-top: $space-4;
    border-top: 1px solid var(--color-border-light);
  }
}

// ── Drop Zone ──────────────────────────────────────────────
.doc-dropzone {
  @include flex-col;
  @include flex-center;
  gap: $space-3;
  padding: $space-8 $space-6;
  border: 2px dashed var(--color-border);
  border-radius: $radius-lg;
  background: var(--color-bg-input);
  cursor: pointer;
  transition: all $transition-fast;
  text-align: center;

  &__icon {
    font-size: 40px;
    color: var(--color-text-muted);
    opacity: 0.4;
    font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 48;
  }

  &__label {
    font-size: $font-size-base;
    font-weight: $font-weight-medium;
    color: var(--color-text-secondary);
  }

  &__hint {
    font-size: $font-size-xs;
    color: var(--color-text-muted);
    max-width: 360px;
    line-height: 1.5;
  }

  &:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-light);

    .doc-dropzone__icon {
      opacity: 0.8;
      color: var(--color-primary);
    }

    .doc-dropzone__label {
      color: var(--color-primary);
    }
  }
}

// ── File Selected ──────────────────────────────────────────
.doc-file-selected {
  @include flex-between;
  padding: $space-4;
  background: var(--color-bg-input);
  border: 1px solid var(--color-border);
  border-radius: $radius-md;

  &__info {
    @include flex-start;
    gap: $space-3;
  }

  &__icon {
    font-size: 28px;
    color: var(--color-primary);
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }

  &__name {
    font-size: $font-size-sm;
    font-weight: $font-weight-semibold;
    color: var(--color-text-primary);
  }

  &__size {
    font-size: $font-size-xs;
    color: var(--color-text-muted);
  }

  &__remove {
    @include btn-ghost;
    width: 30px;
    height: 30px;
    padding: 0;
    border-radius: $radius-md;
    @include flex-center;
    color: var(--color-text-muted);

    .material-symbols-outlined {
      font-size: 18px;
    }

    &:hover {
      color: var(--color-danger);
      background: var(--color-danger-subtle);
    }
  }
}

// ── Preview ────────────────────────────────────────────────
.doc-preview {
  border-radius: $radius-md;
  overflow: hidden;
  border: 1px solid var(--color-border);
  max-height: 280px;

  &__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    max-height: 280px;
    background: var(--color-bg-input);
  }

  &__pdf {
    width: 100%;
    height: 280px;
    border: none;
  }

  &__video {
    width: 100%;
    max-height: 280px;
    background: #000;
    border-radius: $radius-md;
  }

  &__audio {
    width: 100%;
    padding: $space-4;
    background: var(--color-bg-input);
    border-radius: $radius-md;
  }
}

.doc-preview-placeholder {
  @include flex-col;
  @include flex-center;
  gap: $space-3;
  padding: $space-8;
  background: var(--color-bg-input);
  border: 1px solid var(--color-border);
  border-radius: $radius-md;
  text-align: center;

  .material-symbols-outlined {
    font-size: 48px;
    opacity: 0.3;
    font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 48;
  }

  p {
    font-size: $font-size-sm;
    color: var(--color-text-muted);
  }
}

// ══ CONFIRM DIALOG ════════════════════════════════════════
.confirm-dialog {
  background: var(--color-bg-card);
  border-radius: $radius-xl;
  box-shadow: var(--shadow-lg);
  width: 100%;
  max-width: 420px;
  padding: $space-8;
  @include flex-col;
  align-items: center;
  text-align: center;
  gap: $space-4;

  &__icon {
    width: 56px;
    height: 56px;
    border-radius: $radius-full;
    @include flex-center;

    .material-symbols-outlined {
      font-size: 28px;
      font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    &--danger {
      background: var(--color-danger-subtle);
      color: var(--color-danger);
    }
  }

  &__title {
    font-size: $font-size-xl;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
  }

  &__text {
    font-size: $font-size-sm;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  &__actions {
    @include flex-center;
    gap: $space-3;
    margin-top: $space-2;
  }
}

.btn-danger {
  @include btn-base;
  background: var(--color-danger);
  color: white;

  &:hover:not(:disabled) {
    background: var(--color-danger-hover);
  }
}
