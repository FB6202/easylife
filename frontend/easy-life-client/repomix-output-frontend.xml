@use '../../../../styles/variables' as *;
@use '../../../../styles/mixins' as *;

.support-page {
  background: var(--color-bg);
}

// ── Hero ───────────────────────────────────────────────────
.support-hero {
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
  padding: $space-16 0 $space-12;

  &__inner {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 $space-6;
    @include flex-col;
    align-items: center;
    text-align: center;
    gap: $space-5;
  }

  &__label {
    @include section-label;
    color: rgba(255, 255, 255, 0.7);
  }

  &__title {
    font-size: $font-size-4xl;
    font-weight: $font-weight-bold;
    color: white;
    line-height: 1.15;

    @include below-md {
      font-size: $font-size-3xl;
    }
  }

  &__subtitle {
    font-size: $font-size-lg;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
  }

  &__search {
    @include flex-start;
    gap: $space-3;
    background: white;
    border-radius: $radius-pill;
    padding: $space-3 $space-5;
    width: 100%;
    max-width: 500px;
    box-shadow: var(--shadow-lg);

    .material-symbols-outlined {
      font-size: 20px;
      color: var(--color-text-muted);
      flex-shrink: 0;
    }

    input {
      flex: 1;
      border: none;
      outline: none;
      font-family: $font-family;
      font-size: $font-size-base;
      color: var(--color-text-primary);
      background: transparent;

      &::placeholder {
        color: var(--color-text-muted);
      }
    }
  }

  &__tags {
    @include flex-start;
    gap: $space-2;
    flex-wrap: wrap;
    justify-content: center;
  }
}

.support-tag {
  padding: $space-1 $space-3;
  border-radius: $radius-pill;
  background: rgba(255, 255, 255, 0.15);
  color: white;
  font-size: $font-size-xs;
  font-weight: $font-weight-medium;
  cursor: pointer;
  transition: background $transition-fast;
  border: 1px solid rgba(255, 255, 255, 0.2);

  &:hover {
    background: rgba(255, 255, 255, 0.25);
  }
}

// ── Categories ─────────────────────────────────────────────
.support-categories {
  padding: $space-16 0;
  background: white;

  &__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 $space-6;
  }

  &__title {
    font-size: $font-size-2xl;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
    margin-bottom: $space-8;
  }

  &__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: $space-4;

    @include below-lg {
      grid-template-columns: repeat(2, 1fr);
    }
    @include below-md {
      grid-template-columns: 1fr;
    }
  }
}

.support-category-card {
  @include flex-start;
  gap: $space-4;
  padding: $space-5;
  border: 1px solid var(--color-border);
  border-radius: $radius-lg;
  cursor: pointer;
  transition: all $transition-base;
  background: var(--color-bg-card);

  &:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);

    .support-category-card__arrow {
      color: var(--color-primary);
      transform: translateX(3px);
    }
  }

  &__icon {
    width: 48px;
    height: 48px;
    border-radius: $radius-md;
    background: var(--color-primary-light);
    @include flex-center;
    flex-shrink: 0;

    .material-symbols-outlined {
      font-size: 24px;
      color: var(--color-primary);
      font-variation-settings:
        'FILL' 0,
        'wght' 400,
        'GRAD' 0,
        'opsz' 24;
    }
  }

  &__content {
    @include flex-col;
    gap: 3px;
    flex: 1;
    min-width: 0;
  }

  &__title {
    font-size: $font-size-base;
    font-weight: $font-weight-semibold;
    color: var(--color-text-primary);
  }

  &__desc {
    font-size: $font-size-xs;
    color: var(--color-text-secondary);
    line-height: 1.5;
    @include truncate(2);
  }

  &__count {
    font-size: $font-size-xs;
    color: var(--color-primary);
    font-weight: $font-weight-medium;
    margin-top: $space-1;
  }

  &__arrow {
    font-size: 20px;
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition: all $transition-base;
  }
}

// ── FAQ ────────────────────────────────────────────────────
.support-faq {
  padding: $space-16 0;

  &__inner {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 $space-6;
  }

  &__header {
    @include flex-col;
    gap: $space-2;
    margin-bottom: $space-10;
  }

  &__title {
    font-size: $font-size-2xl;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
  }

  &__subtitle {
    font-size: $font-size-base;
    color: var(--color-text-secondary);
  }

  &__list {
    @include flex-col;
    gap: $space-2;
  }
}

.faq-item {
  border: 1px solid var(--color-border);
  border-radius: $radius-lg;
  overflow: hidden;
  transition: border-color $transition-fast;
  background: var(--color-bg-card);

  &--open {
    border-color: var(--color-primary);
  }

  &__header {
    @include flex-between;
    gap: $space-4;
    padding: $space-5 $space-6;
    background: none;
    border: none;
    cursor: pointer;
    width: 100%;
    text-align: left;
    transition: background $transition-fast;

    &:hover {
      background: var(--color-bg-hover);
    }
  }

  &__question {
    font-size: $font-size-base;
    font-weight: $font-weight-medium;
    color: var(--color-text-primary);
  }

  &__icon {
    font-size: 20px;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  &__answer {
    padding: 0 $space-6 $space-5;
    border-top: 1px solid var(--color-border-light);

    p {
      font-size: $font-size-sm;
      color: var(--color-text-secondary);
      line-height: 1.7;
      padding-top: $space-4;
    }
  }
}

// ── Contact ────────────────────────────────────────────────
.support-contact {
  background: var(--color-bg);
  padding: $space-16 0;

  &__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 $space-6;
    @include flex-col;
    align-items: center;
    text-align: center;
    gap: $space-10;
  }

  &__title {
    font-size: $font-size-2xl;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
  }

  &__subtitle {
    font-size: $font-size-base;
    color: var(--color-text-secondary);
    margin-top: -$space-6;
  }

  &__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: $space-5;
    width: 100%;

    @include below-lg {
      grid-template-columns: 1fr;
      max-width: 400px;
    }
  }
}

.contact-card {
  @include card($space-8);
  @include flex-col;
  align-items: center;
  text-align: center;
  gap: $space-4;
  transition:
    box-shadow $transition-base,
    transform $transition-base;

  &:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  &--featured {
    border-color: var(--color-primary);
    border-width: 2px;
    box-shadow: 0 4px 20px rgba(67, 160, 71, 0.12);
  }

  &__icon {
    width: 56px;
    height: 56px;
    border-radius: $radius-full;
    background: var(--color-primary-light);
    @include flex-center;

    .material-symbols-outlined {
      font-size: 26px;
      color: var(--color-primary);
      font-variation-settings:
        'FILL' 0,
        'wght' 400,
        'GRAD' 0,
        'opsz' 24;
    }
  }

  &__title {
    font-size: $font-size-lg;
    font-weight: $font-weight-semibold;
    color: var(--color-text-primary);
  }

  &__desc {
    font-size: $font-size-sm;
    color: var(--color-text-secondary);
    line-height: 1.6;
    flex: 1;
  }
}
