@use '../../../styles/variables' as *;
@use '../../../styles/mixins' as *;

// ── Layout ─────────────────────────────────────────────────
.workspace {
  display: grid;
  grid-template-columns: 220px 1fr;
  min-height: 100vh;
  background: var(--color-bg);
  transition: grid-template-columns $transition-base;

  &.sidebar-collapsed {
    grid-template-columns: 0px 1fr;

    .sidebar {
      transform: translateX(-100%);
      pointer-events: none;
    }
  }
}

// ── Sidebar ────────────────────────────────────────────────
.sidebar {
  @include flex-col;
  background: var(--color-bg-card);
  border-right: 1px solid var(--color-border);
  height: 100vh;
  position: sticky;
  top: 0;
  overflow: hidden;
  transition: transform $transition-base;
  z-index: 50;

  &__logo {
    padding: $space-5 $space-5 $space-4;
    border-bottom: 1px solid var(--color-border-light);

    img {
      height: 32px;
      width: auto;
    }
  }

  &__nav {
    @include flex-col;
    gap: $space-1;
    flex: 1;
    padding: $space-4 $space-3;
    overflow-y: auto;
    @include scrollbar-thin;
  }

  &__section {
    @include flex-col;
    gap: $space-1;
    margin-bottom: $space-4;
  }

  &__section-label {
    font-size: $font-size-xs;
    font-weight: $font-weight-bold;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0 $space-3;
    margin-bottom: $space-2;
  }

  &__item {
    @include flex-start;
    gap: $space-3;
    padding: $space-2 $space-3;
    border-radius: $radius-md;
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: all $transition-fast;
    cursor: pointer;
    border: none;
    background: none;
    font-family: $font-family;
    width: 100%;

    &:hover {
      background: var(--color-bg-hover);
      color: var(--color-text-primary);
    }

    &.active {
      background: var(--color-primary-light);
      color: var(--color-primary);
      font-weight: $font-weight-semibold;

      .sidebar__icon {
        color: var(--color-primary);
        font-variation-settings:
          'FILL' 1,
          'wght' 400,
          'GRAD' 0,
          'opsz' 20;
      }
    }
  }

  &__icon {
    font-size: 20px;
    flex-shrink: 0;
    font-variation-settings:
      'FILL' 0,
      'wght' 400,
      'GRAD' 0,
      'opsz' 20;
    color: var(--color-text-muted);
    transition: all $transition-fast;
  }

  &__label {
    flex: 1;
  }

  &__badge {
    margin-left: auto;
    background: var(--color-danger);
    color: white;
    font-size: 10px;
    font-weight: $font-weight-bold;
    padding: 1px 6px;
    border-radius: $radius-pill;
    min-width: 18px;
    text-align: center;
    line-height: 16px;
  }

  &__logout {
    color: var(--color-text-muted);

    &:hover {
      color: var(--color-danger);
      background: rgba(211, 47, 47, 0.06);
    }
  }

  &__footer {
    padding: $space-3;
    border-top: 1px solid var(--color-border-light);
  }
}

// ── Main ───────────────────────────────────────────────────
.workspace__main {
  @include flex-col;
  min-height: 100vh;
  overflow: hidden;
}

// ── Topbar ─────────────────────────────────────────────────
.topbar {
  @include flex-between;
  padding: 0 $space-6;
  height: 60px;
  background: var(--color-bg-card);
  border-bottom: 1px solid var(--color-border);
  position: sticky;
  top: 0;
  z-index: 40;
  flex-shrink: 0;
  gap: $space-4;

  &__left {
    @include flex-start;
    gap: $space-3;
  }
  &__right {
    @include flex-start;
    gap: $space-3;
  }

  &__toggle {
    @include btn-ghost;
    width: 36px;
    height: 36px;
    border-radius: $radius-md;
    @include flex-center;
    .material-symbols-outlined {
      font-size: 22px;
    }
  }

  &__search {
    @include flex-start;
    gap: $space-2;
    background: var(--color-bg-input);
    border: 1px solid var(--color-border);
    border-radius: $radius-md;
    padding: $space-2 $space-3;
    min-width: 220px;
    transition: border-color $transition-fast;

    &:focus-within {
      border-color: var(--color-primary);
    }

    .material-symbols-outlined {
      font-size: 18px;
      color: var(--color-text-muted);
    }

    input {
      border: none;
      outline: none;
      font-family: $font-family;
      font-size: $font-size-sm;
      color: var(--color-text-primary);
      background: transparent;
      width: 100%;

      &::placeholder {
        color: var(--color-text-muted);
      }
    }
  }

  &__icon-btn {
    @include btn-ghost;
    width: 36px;
    height: 36px;
    border-radius: $radius-md;
    @include flex-center;
    border: 1px solid var(--color-border);
    transition: all $transition-fast;

    .material-symbols-outlined {
      font-size: 20px;
    }

    &:hover {
      border-color: var(--color-primary);
      color: var(--color-primary);
      background: var(--color-primary-light);
    }
  }

  &__user {
    @include flex-start;
    gap: $space-3;
    cursor: pointer;
    padding: $space-2 $space-3;
    border-radius: $radius-md;
    transition: background $transition-fast;
    border: 1px solid transparent;

    &:hover {
      background: var(--color-bg-hover);
      border-color: var(--color-border);
    }
  }

  &__user-info {
    @include flex-col;
    gap: 1px;
    text-align: right;
  }

  &__user-name {
    font-size: $font-size-sm;
    font-weight: $font-weight-semibold;
    color: var(--color-text-primary);
  }

  &__user-plan {
    font-size: $font-size-xs;
    color: var(--color-text-muted);
  }

  &__avatar {
    width: 34px;
    height: 34px;
    border-radius: $radius-full;
    background: var(--color-primary);
    color: white;
    font-size: $font-size-sm;
    font-weight: $font-weight-bold;
    @include flex-center;
    flex-shrink: 0;
  }
}

// ── Content ────────────────────────────────────────────────
.workspace__content {
  flex: 1;
  padding: $space-6;
  overflow-y: auto;
}
