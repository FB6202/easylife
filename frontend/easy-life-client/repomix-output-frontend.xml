      <div class="nprofile-contact-card__info">
        <h3 class="nprofile-contact-card__name">{{ contact.firstname }} {{ contact.lastname }}</h3>
        <p class="nprofile-contact-card__position">{{ contact.position }} · {{ contact.company }}</p>
      </div>
      <span class="nprofile-contact-card__type">{{ contact.relationshipType }}</span>
    </div>
