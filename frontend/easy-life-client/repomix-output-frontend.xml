  &__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 $space-6;
    display: grid;
    grid-template-columns: repeat(4, 1fr);

    @include below-lg {
      grid-template-columns: repeat(2, 1fr);
