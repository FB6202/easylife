<!-- ══ EDIT MODAL ════════════════════════════════════════ -->
@if (showEditModal() && selectedContact()) {
<div class="modal-overlay" (click)="showEditModal.set(false); showEditCatDropdown.set(false)">
  <div class="contact-modal" (click)="$event.stopPropagation(); showEditCatDropdown.set(false)">

    <div class="contact-modal__header">
      <div class="contact-modal__header-info">
        <div class="contact-modal__avatar" [style.background]="selectedContact()!.avatarColor">
          {{ selectedContact()!.initials }}
        </div>
        <div>
          <h2 class="contact-modal__title">
            {{ selectedContact()!.firstname }} {{ selectedContact()!.lastname }}
          </h2>
          <p class="contact-modal__subtitle">
            {{ selectedContact()!.position }}
            @if (selectedContact()!.company) { · {{ selectedContact()!.company }} }
          </p>
        </div>
      </div>
      <div class="contact-modal__header-actions">
        <button class="contact-modal__action-btn contact-modal__action-btn--delete" (click)="openDeleteConfirm()"
          title="Delete contact">
          <span class="material-symbols-outlined">delete</span>
        </button>
        <button class="contact-modal__close" (click)="showEditModal.set(false)">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
    </div>

    <div class="contact-modal__row">
      <div class="form-group">
        <label>First Name</label>
        <input type="text" placeholder="Jane" [(ngModel)]="editForm().firstname" />
      </div>
      <div class="form-group">
        <label>Last Name</label>
        <input type="text" placeholder="Doe" [(ngModel)]="editForm().lastname" />
      </div>
    </div>

    <div class="contact-modal__row">
      <div class="form-group">
        <label>Company <span class="form-group__optional">optional</span></label>
        <input type="text" placeholder="Company name" [(ngModel)]="editForm().company" />
      </div>
      <div class="form-group">
        <label>Position <span class="form-group__optional">optional</span></label>
        <input type="text" placeholder="Job title" [(ngModel)]="editForm().position" />
      </div>
    </div>

    <div class="contact-modal__row">
      <div class="form-group">
        <label>Email <span class="form-group__optional">optional</span></label>
        <input type="email" placeholder="jane@example.com" [(ngModel)]="editForm().email" />
      </div>
      <div class="form-group">
        <label>Phone <span class="form-group__optional">optional</span></label>
        <input type="tel" placeholder="+49 123 456789" [(ngModel)]="editForm().phone" />
      </div>
    </div>

    <div class="contact-modal__row">
      <div class="form-group">
        <label>LinkedIn <span class="form-group__optional">optional</span></label>
        <input type="url" placeholder="linkedin.com/in/..." [(ngModel)]="editForm().linkedinUrl" />
      </div>
      <div class="form-group">
        <label>Website <span class="form-group__optional">optional</span></label>
        <input type="url" placeholder="https://..." [(ngModel)]="editForm().websiteUrl" />
      </div>
    </div>

    <div class="form-group">
      <label>Relationship Type</label>
      <div class="modal-type-picker">
        @for (type of relationshipTypes; track type) {
        <button
          [class]="'modal-type-btn modal-type-btn--' + type.toLowerCase() + (editForm().relationshipType === type ? ' active' : '')"
          (click)="editForm.update(f => ({ ...f, relationshipType: type }))">
          {{ getRelationshipLabel(type) }}
        </button>
        }
      </div>
    </div>

    <div class="form-group">
      <label>Skills & Keywords</label>
      <div class="skill-input-row">
        <input type="text" placeholder="Add skill and press Enter..." [value]="newSkillInput()"
          (input)="newSkillInput.set($any($event.target).value)" (keydown)="onSkillKeydown($event, 'edit')" />
        <button class="skill-add-btn" (click)="addSkillToEdit()">
          <span class="material-symbols-outlined">add</span>
        </button>
      </div>
      @if (editForm().skills.length > 0) {
      <div class="skill-tags">
        @for (skill of editForm().skills; track skill) {
        <span class="skill-tag">
          {{ skill }}
          <button (click)="removeSkillFromEdit(skill)">
            <span class="material-symbols-outlined">close</span>
          </button>
        </span>
        }
      </div>
      }
    </div>

    <div class="form-group">
      <label>Notes <span class="form-group__optional">optional</span></label>
      <textarea rows="3" placeholder="How did you meet? What's important to remember?"
        [(ngModel)]="editForm().notes"></textarea>
    </div>

    <!-- Categories Dropdown -->
    <div class="form-group" (click)="$event.stopPropagation()">
      <label>Categories</label>
      <div class="modal-cat-dropdown">
        <button class="modal-cat-dropdown__trigger"
          [class.modal-cat-dropdown__trigger--active]="editForm().categoryIds.length > 0"
          [class.modal-cat-dropdown__trigger--open]="showEditCatDropdown()" (click)="toggleEditCatDropdown($event)">
          <div class="modal-cat-dropdown__trigger-left">
            @if (editForm().categoryIds.length > 0) {
            <div class="modal-cat-dropdown__dots">
              @for (color of getSelectedCatColors(editForm().categoryIds); track color) {
              <span class="modal-cat-dropdown__dot" [style.background]="color"></span>
              }
            </div>
            }
            <span class="modal-cat-dropdown__label">
              {{ getCatDropdownLabel(editForm().categoryIds) }}
            </span>
          </div>
          <span class="material-symbols-outlined modal-cat-dropdown__arrow">
            {{ showEditCatDropdown() ? 'expand_less' : 'expand_more' }}
          </span>
        </button>
        @if (showEditCatDropdown()) {
        <div class="modal-cat-dropdown__menu">
          @for (cat of availableCategories(); track cat.id) {
          <button class="modal-cat-dropdown__item"
            [class.modal-cat-dropdown__item--selected]="editForm().categoryIds.includes(cat.id)"
            (click)="toggleEditCategory(cat.id)">
            <div class="modal-cat-dropdown__item-check">
              @if (editForm().categoryIds.includes(cat.id)) {
              <span class="material-symbols-outlined">check</span>
              }
            </div>
            <span class="material-symbols-outlined modal-cat-dropdown__item-icon" [style.color]="cat.color">{{ cat.icon
              }}</span>
            <span class="modal-cat-dropdown__item-label">{{ cat.name }}</span>
          </button>
          }
          @if (editForm().categoryIds.length > 0) {
          <div class="modal-cat-dropdown__footer">
            <button class="modal-cat-dropdown__clear"
              (click)="editForm.update(f => ({ ...f, categoryIds: [] })); $event.stopPropagation()">
              <span class="material-symbols-outlined">close</span>Clear
            </button>
          </div>
          }
        </div>
        }
      </div>
    </div>

    <div class="contact-modal__footer">
      <button class="btn-secondary" (click)="showEditModal.set(false)">Cancel</button>
      <button class="btn-primary" (click)="submitEdit()">Save Changes</button>
    </div>
  </div>
</div>
}

<!-- ══ DELETE CONFIRM ════════════════════════════════════ -->
@if (showDeleteConfirm() && selectedContact()) {
<div class="modal-overlay" (click)="showDeleteConfirm.set(false)">
  <div class="confirm-dialog" (click)="$event.stopPropagation()">
    <div class="confirm-dialog__icon confirm-dialog__icon--danger">
      <span class="material-symbols-outlined">delete</span>
    </div>
    <h3 class="confirm-dialog__title">Delete Contact</h3>
    <p class="confirm-dialog__text">
      Are you sure you want to delete
      <strong>"{{ selectedContact()!.firstname }} {{ selectedContact()!.lastname }}"</strong>?
      This action cannot be undone.
    </p>
    <div class="confirm-dialog__actions">
      <button class="btn-secondary" (click)="showDeleteConfirm.set(false)">Cancel</button>
      <button class="btn-danger" (click)="confirmDelete()">Delete Contact</button>
    </div>
  </div>
</div>
}
</file>

<file path="src/app/pages/workspace/network/network.scss">
@use '../../../../styles/variables' as *;
@use '../../../../styles/mixins' as *;

// ── Header ─────────────────────────────────────────────────
.network-header {
  @include flex-between;
  margin-bottom: $space-5;
  gap: $space-4;
  flex-wrap: wrap;
  align-items: flex-end;

  &__text {
    @include flex-col;
    gap: $space-1;
  }

  &__title {
    font-size: $font-size-3xl;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
  }

  &__subtitle {
    font-size: $font-size-sm;
    color: var(--color-text-secondary);
  }

  &__actions {
    @include flex-start;
    gap: $space-3;
  }
}

// ── Tag Filter ─────────────────────────────────────────────
.network-tags {
  @include flex-start;
  gap: $space-2;
  margin-bottom: $space-5;
  flex-wrap: wrap;

  &__sort {
    @include flex-start;
    gap: $space-1;
    margin-left: auto;
    font-size: $font-size-xs;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color $transition-fast;

    .material-symbols-outlined {
      font-size: 15px;
    }

    &:hover {
      color: var(--color-text-primary);
    }
  }
}

.network-tag {
  padding: $space-2 $space-4;
  border-radius: $radius-pill;
  border: 1px solid var(--color-border);
  background: var(--color-bg-card);
  font-family: $font-family;
  font-size: $font-size-sm;
  font-weight: $font-weight-medium;
  color: var(--color-text-secondary);
  cursor: pointer;
  transition: all $transition-fast;

  &:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: var(--color-primary-light);
  }

  &--active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;

    &:hover {
      background: var(--color-primary-hover);
      color: white;
    }
  }
}

// ── Container ──────────────────────────────────────────────
.network-container {
  @include card(0);
  overflow: hidden;
}

// ── Table ──────────────────────────────────────────────────
.network-table__header {
  display: grid;
  grid-template-columns: 2fr 2fr 120px 100px 120px;
  padding: $space-3 $space-6;
  background: var(--color-bg-input);
  border-bottom: 1px solid var(--color-border);
  gap: $space-4;
}

.network-table__row {
  display: grid;
  grid-template-columns: 2fr 2fr 120px 100px 120px;
  padding: $space-4 $space-6;
  border-bottom: 1px solid var(--color-border-light);
  gap: $space-4;
  align-items: center;
  transition: background $transition-fast;
  cursor: pointer;

  &:last-of-type {
    border-bottom: none;
  }

  &:hover {
    background: var(--color-bg-hover);
  }
}

.network-col {
  @include flex-start;
  font-size: $font-size-xs;
  font-weight: $font-weight-semibold;
  color: var(--color-text-muted);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  gap: $space-3;
}

// ── Contact Info ───────────────────────────────────────────
.contact-avatar {
  width: 38px;
  height: 38px;
  border-radius: $radius-full;
  @include flex-center;
  font-size: $font-size-xs;
  font-weight: $font-weight-bold;
  color: white;
  flex-shrink: 0;
}

.contact-info {
  @include flex-col;
  gap: 2px;
  min-width: 0;

  &__name {
    font-size: $font-size-sm;
    font-weight: $font-weight-semibold;
    color: var(--color-text-primary);
    @include truncate;
  }

  &__role {
    font-size: $font-size-xs;
    color: var(--color-text-muted);
    @include truncate;
  }
}

// ── Skills ─────────────────────────────────────────────────
.contact-skills {
  @include flex-start;
  gap: $space-2;
  flex-wrap: wrap;
}

.contact-skill-tag {
  font-size: $font-size-xs;
  font-weight: $font-weight-medium;
  padding: 2px $space-2;
  border-radius: $radius-pill;
  background: var(--color-bg-input);
  border: 1px solid var(--color-border);
  color: var(--color-text-secondary);
  white-space: nowrap;
}

.contact-skill-more {
  font-size: $font-size-xs;
  font-weight: $font-weight-semibold;
  color: var(--color-text-muted);
  padding: 2px $space-2;
}

// ── Categories ─────────────────────────────────────────────
.contact-cats {
  @include flex-start;
  gap: $space-2;
}

.contact-cat-icon {
  font-size: 18px;
  font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
}

// ── Type Badge ─────────────────────────────────────────────
.contact-type {
  font-size: $font-size-xs;
  font-weight: $font-weight-bold;
  padding: 3px $space-3;
  border-radius: $radius-pill;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  white-space: nowrap;

  &.type--business {
    background: var(--color-info-subtle);
    color: var(--color-info-text);
    border: 1px solid var(--color-info-border);
  }

  &.type--colleague {
    background: var(--color-success-subtle);
    color: var(--color-success-text);
    border: 1px solid var(--color-success-border);
  }

  &.type--mentor {
    background: var(--color-purple-subtle);
    color: var(--color-purple-text);
    border: 1px solid var(--color-purple-border);
  }

  &.type--friend {
    background: var(--color-warning-subtle);
    color: var(--color-warning-text);
    border: 1px solid var(--color-warning-border);
  }

  &.type--other {
    background: var(--color-neutral-subtle);
    color: var(--color-neutral-text);
    border: 1px solid var(--color-neutral-border);
  }
}

// ── Last Contact ───────────────────────────────────────────
.contact-last__icon {
  font-size: 16px;
  color: var(--color-text-muted);
}

.contact-last__text {
  font-size: $font-size-sm;
  color: var(--color-text-secondary);
}

// ══ MODAL OVERLAY ════════════════════════════════════════
.modal-overlay {
  position: fixed;
  inset: 0;
  background: var(--color-overlay);
  backdrop-filter: blur(4px);
  z-index: 200;
  @include flex-center;
  padding: $space-4;
}

// ══ CONTACT MODAL ════════════════════════════════════════
.contact-modal {
  background: var(--color-bg-card);
  border-radius: $radius-xl;
  box-shadow: var(--shadow-lg);
  width: 100%;
  max-width: 620px;
  max-height: 90vh;
  overflow-y: auto;
  @include scrollbar-thin;
  @include flex-col;
  gap: $space-4;
  padding: $space-8;

  &__header {
    @include flex-between;
    align-items: flex-start;
    gap: $space-4;
  }

  &__header-info {
    @include flex-start;
    gap: $space-4;
    flex: 1;
    min-width: 0;
  }

  &__avatar {
    width: 52px;
    height: 52px;
    border-radius: $radius-full;
    @include flex-center;
    font-size: $font-size-lg;
    font-weight: $font-weight-bold;
    color: white;
    flex-shrink: 0;
  }

  &__header-actions {
    @include flex-start;
    gap: $space-2;
  }

  &__title {
    font-size: $font-size-xl;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
  }

  &__subtitle {
    font-size: $font-size-sm;
    color: var(--color-text-muted);
    margin-top: 2px;
  }

  &__close {
    @include btn-ghost;
    border-radius: $radius-md;
    padding: $space-1;
    flex-shrink: 0;

    .material-symbols-outlined {
      font-size: 22px;
    }
  }

  &__action-btn {
    width: 36px;
    height: 36px;
    border-radius: $radius-md;
    border: none;
    @include flex-center;
    cursor: pointer;
    transition: all $transition-fast;

    .material-symbols-outlined {
      font-size: 18px;
    }

    &--delete {
      background: var(--color-danger-subtle);
      color: var(--color-danger);

      &:hover {
        background: var(--color-danger-subtle);
        filter: brightness(0.9);
      }
    }
  }

  &__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: $space-4;

    @include below-md {
      grid-template-columns: 1fr;
    }
  }

  &__footer {
    @include flex-between;
    padding-top: $space-4;
    border-top: 1px solid var(--color-border-light);
  }
}

// ── Relationship Type Picker ───────────────────────────────
.modal-type-picker {
  @include flex-start;
  gap: $space-2;
  flex-wrap: wrap;
}

.modal-type-btn {
  padding: $space-1 $space-3;
  border-radius: $radius-pill;
  border: 1px solid var(--color-border);
  background: var(--color-bg-card);
  font-family: $font-family;
  font-size: $font-size-xs;
  font-weight: $font-weight-medium;
  color: var(--color-text-muted);
  cursor: pointer;
  transition: all $transition-fast;

  &:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  &--business.active {
    background: var(--color-info-subtle);
    color: var(--color-info-text);
    border-color: var(--color-info-border);
  }

  &--colleague.active {
    background: var(--color-success-subtle);
    color: var(--color-success-text);
    border-color: var(--color-success-border);
  }

  &--mentor.active {
    background: var(--color-purple-subtle);
    color: var(--color-purple-text);
    border-color: var(--color-purple-border);
  }

  &--friend.active {
    background: var(--color-warning-subtle);
    color: var(--color-warning-text);
    border-color: var(--color-warning-border);
  }

  &--other.active {
    background: var(--color-neutral-subtle);
    color: var(--color-neutral-text);
    border-color: var(--color-neutral-border);
  }
}

// ── Skills Input ───────────────────────────────────────────
.skill-input-row {
  @include flex-start;
  gap: $space-2;

  input {
    @include input-base;
    flex: 1;
  }
}

.skill-add-btn {
  width: 40px;
  height: 40px;
  border-radius: $radius-md;
  border: 1px solid var(--color-border);
  background: var(--color-bg-card);
  @include flex-center;
  cursor: pointer;
  flex-shrink: 0;
  color: var(--color-text-secondary);
  transition: all $transition-fast;

  .material-symbols-outlined {
    font-size: 20px;
  }

  &:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: var(--color-primary-light);
  }
}

.skill-tags {
  @include flex-start;
  gap: $space-2;
  flex-wrap: wrap;
  margin-top: $space-3;
}

.skill-tag {
  @include flex-start;
  gap: $space-1;
  font-size: $font-size-xs;
  font-weight: $font-weight-medium;
  padding: 3px $space-2 3px $space-3;
  border-radius: $radius-pill;
  background: var(--color-primary-light);
  color: var(--color-primary);
  border: 1px solid var(--color-primary-border);

  button {
    @include flex-center;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    color: var(--color-primary);
    opacity: 0.6;
    transition: opacity $transition-fast;

    .material-symbols-outlined {
      font-size: 13px;
    }

    &:hover {
      opacity: 1;
    }
  }
}

// ══ CONFIRM DIALOG ════════════════════════════════════════
.confirm-dialog {
  background: var(--color-bg-card);
  border-radius: $radius-xl;
  box-shadow: var(--shadow-lg);
  width: 100%;
  max-width: 420px;
  padding: $space-8;
  @include flex-col;
  align-items: center;
  text-align: center;
  gap: $space-4;

  &__icon {
    width: 56px;
    height: 56px;
    border-radius: $radius-full;
    @include flex-center;

    .material-symbols-outlined {
      font-size: 28px;
      font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    &--danger {
      background: var(--color-danger-subtle);
      color: var(--color-danger);
    }
  }

  &__title {
    font-size: $font-size-xl;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
  }

  &__text {
    font-size: $font-size-sm;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  &__actions {
    @include flex-center;
    gap: $space-3;
    margin-top: $space-2;
  }
}

.btn-danger {
  @include btn-base;
  background: var(--color-danger);
  color: white;

  &:hover:not(:disabled) {
    background: var(--color-danger-hover);
  }
}

.btn-secondary--active {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: var(--color-primary-light);
}

.filter-active-badge {
  background: var(--color-primary);
  color: white;
  font-size: 11px;
  font-weight: $font-weight-bold;
  padding: 1px 6px;
  border-radius: $radius-pill;
  margin-left: $space-1;
  min-width: 18px;
  text-align: center;
}
</file>

<file path="src/app/pages/workspace/network/network.ts">
import { Component, signal, computed } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { PaginationComponent } from '../../../shared/components/pagination/pagination';
import {
  FilterPanelComponent,
  FilterField,
  FilterValues,
} from '../../../shared/components/filter/filter';

type RelationshipType = 'FRIEND' | 'COLLEAGUE' | 'BUSINESS' | 'MENTOR' | 'OTHER';

interface CategoryPreview {
  id: number;
  name: string;
  icon: string;
  color: string;
}

interface NetworkTag {
  id: number;
  label: string;
}

interface Contact {
  id: number;
  firstname: string;
  lastname: string;
  company: string;
  position: string;
  email: string | null;
  phone: string | null;
  linkedinUrl: string | null;
  websiteUrl: string | null;
  notes: string;
  tags: NetworkTag[];
  skills: string[];
  lastContactedAt: string;
  relationshipType: RelationshipType;
  categories: CategoryPreview[];
  initials: string;
  avatarColor: string;
}

interface ContactForm {
  firstname: string;
  lastname: string;
  company: string;
  position: string;
  email: string;
  phone: string;
  linkedinUrl: string;
  websiteUrl: string;
  notes: string;
  skills: string[];
  relationshipType: RelationshipType;
  categoryIds: number[];
  tagIds: number[];
}

@Component({
  selector: 'app-network',
  imports: [CommonModule, FormsModule, PaginationComponent, FilterPanelComponent],
  templateUrl: './network.html',
  styleUrl: './network.scss',
})
export class NetworkComponent {
  readonly availableCategories = signal<CategoryPreview[]>([
