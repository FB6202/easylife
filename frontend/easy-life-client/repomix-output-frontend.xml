<!-- Page Header -->
<div class="network-header">
  <div class="network-header__text">
    <h1 class="network-header__title">People</h1>
    <p class="network-header__subtitle">Manage your personal and professional relationships.</p>
  </div>
  <div class="network-header__actions">
    <button class="btn-secondary" [class.btn-secondary--active]="activeFilterCount() > 0"
      (click)="showFilter.set(true)">
      <span class="material-symbols-outlined">tune</span>
      Filters
      @if (activeFilterCount() > 0) {
      <span class="filter-active-badge">{{ activeFilterCount() }}</span>
      }
    </button>
    <button class="btn-primary" (click)="openCreate()">
      <span class="material-symbols-outlined">add</span>
      Add Contact
    </button>
  </div>
</div>

<!-- Tag Filter Row -->
<div class="network-tags">
  @for (tag of availableTags(); track tag.id) {
  <button [class]="'network-tag ' + (activeTagId() === tag.id ? 'network-tag--active' : '')"
    (click)="setActiveTag(tag.id)">
    {{ tag.label }}
  </button>
  }
  <span class="network-tags__sort">
    <span class="material-symbols-outlined">sort</span>Last Contacted
  </span>
</div>

<!-- Contacts Table -->
<div class="network-container">
  <div class="network-table__header">
    <span class="network-col network-col--contact">Contact</span>
    <span class="network-col network-col--skills">Skills & Keywords</span>
    <span class="network-col network-col--type">Type</span>
    <span class="network-col network-col--cats">Categories</span>
    <span class="network-col network-col--last">Last Contact</span>
  </div>

  @for (contact of paginatedContacts(); track contact.id) {
  <div class="network-table__row" (click)="openEdit(contact)">
    <div class="network-col network-col--contact">
      <div class="contact-avatar" [style.background]="contact.avatarColor">
        {{ contact.initials }}
      </div>
      <div class="contact-info">
        <span class="contact-info__name">{{ contact.firstname }} {{ contact.lastname }}</span>
        <span class="contact-info__role">
          {{ contact.position }}
          @if (contact.company) { · {{ contact.company }} }
        </span>
      </div>
    </div>
    <div class="network-col network-col--skills">
      <div class="contact-skills">
        @for (skill of contact.skills.slice(0, 3); track skill) {
        <span class="contact-skill-tag">{{ skill }}</span>
        }
        @if (contact.skills.length > 3) {
        <span class="contact-skill-more">+{{ contact.skills.length - 3 }}</span>
        }
      </div>
    </div>
    <div class="network-col network-col--type">
      <span [class]="'contact-type ' + getRelationshipClass(contact.relationshipType)">
        {{ getRelationshipLabel(contact.relationshipType) }}
      </span>
    </div>
    <div class="network-col network-col--cats">
      <div class="contact-cats">
        @for (cat of contact.categories; track cat.id) {
        <span class="material-symbols-outlined contact-cat-icon" [style.color]="cat.color" [title]="cat.name">{{
          cat.icon }}</span>
        }
      </div>
    </div>
    <div class="network-col network-col--last">
      <span class="material-symbols-outlined contact-last__icon">schedule</span>
      <span class="contact-last__text">{{ contact.lastContactedAt }}</span>
    </div>
  </div>
  }

  <app-pagination [currentPage]="currentPage()" [totalPages]="totalPages()" [totalElements]="totalElements()"
    [pageSize]="pageSize()" (pageChange)="onPageChange($event)" (pageSizeChange)="onPageSizeChange($event)"
    (aiClick)="onAiClick()" />
</div>

<!-- ══ FILTER PANEL ══════════════════════════════════════ -->
@if (showFilter()) {
<app-filter-panel title="Filter People" [fields]="networkFilterFields" [initialValues]="activeFilters()"
  (apply)="onFilterApply($event)" (reset)="onFilterReset()" (close)="showFilter.set(false)" />
}

<!-- ══ CREATE MODAL ══════════════════════════════════════ -->
@if (showCreateModal()) {
<div class="modal-overlay" (click)="showCreateModal.set(false); showCatDropdown.set(false)">
  <div class="contact-modal" (click)="$event.stopPropagation(); showCatDropdown.set(false)">

    <div class="contact-modal__header">
      <div>
        <h2 class="contact-modal__title">Add Contact</h2>
        <p class="contact-modal__subtitle">Add someone to your people network.</p>
      </div>
      <button class="contact-modal__close" (click)="showCreateModal.set(false)">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>

    <div class="contact-modal__row">
      <div class="form-group">
        <label>First Name</label>
        <input type="text" placeholder="Jane" [(ngModel)]="createForm().firstname" />
      </div>
      <div class="form-group">
        <label>Last Name</label>
        <input type="text" placeholder="Doe" [(ngModel)]="createForm().lastname" />
      </div>
    </div>

    <div class="contact-modal__row">
      <div class="form-group">
        <label>Company <span class="form-group__optional">optional</span></label>
        <input type="text" placeholder="Company name" [(ngModel)]="createForm().company" />
      </div>
      <div class="form-group">
        <label>Position <span class="form-group__optional">optional</span></label>
        <input type="text" placeholder="Job title" [(ngModel)]="createForm().position" />
      </div>
    </div>

    <div class="contact-modal__row">
      <div class="form-group">
        <label>Email <span class="form-group__optional">optional</span></label>
        <input type="email" placeholder="jane@example.com" [(ngModel)]="createForm().email" />
      </div>
      <div class="form-group">
        <label>Phone <span class="form-group__optional">optional</span></label>
        <input type="tel" placeholder="+49 123 456789" [(ngModel)]="createForm().phone" />
      </div>
    </div>

    <div class="contact-modal__row">
      <div class="form-group">
        <label>LinkedIn <span class="form-group__optional">optional</span></label>
        <input type="url" placeholder="linkedin.com/in/..." [(ngModel)]="createForm().linkedinUrl" />
      </div>
      <div class="form-group">
        <label>Website <span class="form-group__optional">optional</span></label>
        <input type="url" placeholder="https://..." [(ngModel)]="createForm().websiteUrl" />
      </div>
    </div>

    <div class="form-group">
      <label>Relationship Type</label>
      <div class="modal-type-picker">
