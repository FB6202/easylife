<file path="src/app/pages/workspace/weekplan/weekplan.html">
<!-- Page Header -->
<div class="weekplan-header">
  <div class="weekplan-header__text">
    <h1 class="weekplan-header__title">My Week</h1>
    <p class="weekplan-header__subtitle">Strategize your goals and review your progress.</p>
  </div>
  <div class="weekplan-header__actions">
    <button class="btn-secondary" [class.btn-secondary--active]="activeFilterCount() > 0"
      (click)="showFilter.set(true)">
      <span class="material-symbols-outlined">tune</span>
      Filters
      @if (activeFilterCount() > 0) {
      <span class="filter-active-badge">{{ activeFilterCount() }}</span>
      }
    </button>
    <button class="btn-primary" (click)="openCreate()">
      <span class="material-symbols-outlined">add</span>
      New Week
    </button>
  </div>
</div>

<!-- Week Plans List -->
<div class="weekplan-container">
  @for (plan of paginatedWeekplans(); track plan.id) {
  <div class="week-card" [class]="'week-card--' + plan.status.toLowerCase()" (click)="openEdit(plan)">
    <div class="week-card__header">
      <div class="week-card__header-left">
        <span [class]="'week-card__status ' + getStatusClass(plan.status)">
          <span class="material-symbols-outlined">{{ getStatusIcon(plan.status) }}</span>
          {{ getStatusLabel(plan.status) }}
        </span>
        <div class="week-card__dates">
          <span class="material-symbols-outlined">calendar_today</span>
          {{ plan.startDate }} — {{ plan.endDate }}
        </div>
      </div>
      <div class="week-card__progress-block">
        <div class="week-card__progress-header">
          <span class="week-card__progress-label">{{ getProgressLabel(plan.status) }}</span>
          @if (plan.status === 'DRAFT') {
          <span class="week-card__progress-count">{{ plan.itemsTotal }} total</span>
          } @else {
          <span class="week-card__progress-count">{{ plan.itemsDone }}/{{ plan.itemsTotal }}</span>
          }
        </div>
        @if (plan.status !== 'DRAFT' && plan.itemsTotal > 0) {
        <div class="progress-bar week-card__progress-bar">
          <div class="progress-fill" [style.width.%]="getProgressPercent(plan.itemsDone, plan.itemsTotal)"></div>
        </div>
        }
        <div class="week-card__meta">
          <span class="week-card__created">CREATED: {{ plan.createdAt }}</span>
        </div>
      </div>
    </div>

    <div class="week-card__body">
      <h3 class="week-card__title">{{ plan.title }}</h3>
      <p class="week-card__intention">"{{ plan.intention }}"</p>
      @if (plan.itemsTotal > 0) {
      <div class="week-card__items-preview">
        @for (item of plan.items.slice(0, 4); track item.id) {
        <div class="week-card__item" [class.week-card__item--done]="item.done">
          <span class="material-symbols-outlined">
            {{ item.done ? 'check_circle' : 'radio_button_unchecked' }}
          </span>
          <span>{{ item.title }}</span>
        </div>
        }
        @if (plan.items.length > 4) {
        <span class="week-card__items-more">+{{ plan.items.length - 4 }} more items</span>
        }
      </div>
      }
    </div>

    <div class="week-card__footer">
      <div class="week-card__categories">
        @for (cat of plan.categories; track cat.id) {
        <span class="material-symbols-outlined week-card__cat-icon" [style.color]="cat.color" [title]="cat.name">{{
          cat.icon }}</span>
        }
      </div>
      @if (plan.reflection) {
      <div class="week-card__reflection">
        <span class="material-symbols-outlined">rate_review</span>
        <span>{{ plan.reflection }}</span>
      </div>
      } @else {
      <div class="week-card__reflection week-card__reflection--empty">
        <span class="material-symbols-outlined">rate_review</span>
        <span>No reflection yet</span>
      </div>
      }
    </div>
  </div>
  }

  <div class="weekplan-pagination">
    <app-pagination [currentPage]="currentPage()" [totalPages]="totalPages()" [totalElements]="totalElements()"
      [pageSize]="pageSize()" (pageChange)="onPageChange($event)" (pageSizeChange)="onPageSizeChange($event)"
      (aiClick)="onAiClick()" />
  </div>
</div>

<!-- ══ FILTER PANEL ══════════════════════════════════════ -->
@if (showFilter()) {
<app-filter-panel title="Filter Week Plans" [fields]="weekplanFilterFields" [initialValues]="activeFilters()"
  (apply)="onFilterApply($event)" (reset)="onFilterReset()" (close)="showFilter.set(false)" />
}

<!-- ══ CREATE MODAL ══════════════════════════════════════ -->
@if (showCreateModal()) {
<div class="modal-overlay" (click)="showCreateModal.set(false); showCatDropdown.set(false)">
  <div class="weekplan-modal" (click)="$event.stopPropagation(); showCatDropdown.set(false)">

    <div class="weekplan-modal__header">
      <div>
        <h2 class="weekplan-modal__title">New Week Plan</h2>
        <p class="weekplan-modal__subtitle">Set your intention and plan the week ahead.</p>
      </div>
      <button class="weekplan-modal__close" (click)="showCreateModal.set(false)">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>

    <input class="weekplan-modal__title-input" type="text" placeholder="Week Plan Title"
      [(ngModel)]="createForm().title" />

    <div class="form-group">
      <label>
        <span class="material-symbols-outlined">lightbulb</span>Intention
      </label>
      <textarea rows="2" placeholder="What is your focus and intention for this week?"
        [(ngModel)]="createForm().intention"></textarea>
    </div>

    <div class="weekplan-modal__row">
      <div class="form-group">
        <label>Start Date</label>
        <input type="date" [(ngModel)]="createForm().startDate" />
      </div>
      <div class="form-group">
        <label>End Date</label>
        <input type="date" [(ngModel)]="createForm().endDate" />
      </div>
    </div>

    <div class="form-group">
      <label>Status</label>
      <div class="modal-status-picker">
        @for (s of statuses; track s) {
        <button
          [class]="'modal-status-btn modal-status-btn--' + s.toLowerCase() + (createForm().status === s ? ' active' : '')"
          (click)="createForm.update(f => ({ ...f, status: s }))">
          <span class="material-symbols-outlined">{{ getStatusIcon(s) }}</span>
          {{ getStatusLabel(s) }}
        </button>
        }
      </div>
    </div>

    <!-- Categories Dropdown -->
    <div class="form-group" (click)="$event.stopPropagation()">
      <label>Categories</label>
      <div class="modal-cat-dropdown">
        <button class="modal-cat-dropdown__trigger"
          [class.modal-cat-dropdown__trigger--active]="createForm().categoryIds.length > 0"
          [class.modal-cat-dropdown__trigger--open]="showCatDropdown()" (click)="toggleCatDropdown($event)">
          <div class="modal-cat-dropdown__trigger-left">
            @if (createForm().categoryIds.length > 0) {
            <div class="modal-cat-dropdown__dots">
              @for (color of getSelectedCatColors(createForm().categoryIds); track color) {
              <span class="modal-cat-dropdown__dot" [style.background]="color"></span>
              }
            </div>
            }
            <span class="modal-cat-dropdown__label">
              {{ getCatDropdownLabel(createForm().categoryIds) }}
            </span>
          </div>
          <span class="material-symbols-outlined modal-cat-dropdown__arrow">
            {{ showCatDropdown() ? 'expand_less' : 'expand_more' }}
          </span>
        </button>
        @if (showCatDropdown()) {
        <div class="modal-cat-dropdown__menu">
          @for (cat of availableCategories(); track cat.id) {
          <button class="modal-cat-dropdown__item"
            [class.modal-cat-dropdown__item--selected]="createForm().categoryIds.includes(cat.id)"
            (click)="toggleCreateCategory(cat.id)">
            <div class="modal-cat-dropdown__item-check">
              @if (createForm().categoryIds.includes(cat.id)) {
              <span class="material-symbols-outlined">check</span>
              }
            </div>
            <span class="material-symbols-outlined modal-cat-dropdown__item-icon" [style.color]="cat.color">{{ cat.icon
              }}</span>
            <span class="modal-cat-dropdown__item-label">{{ cat.name }}</span>
          </button>
          }
          @if (createForm().categoryIds.length > 0) {
          <div class="modal-cat-dropdown__footer">
            <button class="modal-cat-dropdown__clear"
              (click)="createForm.update(f => ({ ...f, categoryIds: [] })); $event.stopPropagation()">
              <span class="material-symbols-outlined">close</span>Clear
            </button>
          </div>
          }
        </div>
        }
      </div>
    </div>

    <!-- Weekly Items -->
    <div class="weekplan-modal__section-label">
      <span class="material-symbols-outlined">checklist</span>
      Weekly Items
      <div class="weekplan-modal__section-actions">
        @if (createForm().items.length > 0) {
        <button class="weekplan-modal__convert-all-btn" (click)="convertAllToTasks('create')"
          title="Mark all items as tasks">
          <span class="material-symbols-outlined">check_circle</span>All as tasks
        </button>
        }
        <button class="weekplan-modal__add-item-btn" (click)="addItemToCreate()">
          <span class="material-symbols-outlined">add</span>Add Item
        </button>
      </div>
    </div>

    <div class="week-items-list">
      @for (item of createForm().items; track $index; let i = $index) {
      <div class="week-item-row" [class.week-item-row--task]="item.createAsTask">
        <div class="week-item-row__check">
          <input type="checkbox" [checked]="item.done"
            (change)="updateCreateItem(i, 'done', $any($event.target).checked)" />
        </div>
        <input type="text" class="week-item-row__title" [class.week-item-row__title--done]="item.done"
          placeholder="Item title..." [value]="item.title"
          (input)="updateCreateItem(i, 'title', $any($event.target).value)" />
        <input type="date" class="week-item-row__date" [value]="item.dueDate"
          (input)="updateCreateItem(i, 'dueDate', $any($event.target).value)" />
        <button class="week-item-row__task-toggle" [class.week-item-row__task-toggle--active]="item.createAsTask"
          (click)="toggleCreateAsTask(i, 'create')"
          [title]="item.createAsTask ? 'Will be created as Task' : 'Also create as Task'">
          <span class="material-symbols-outlined">check_circle</span>
        </button>
        <button class="week-item-row__remove" (click)="removeItemFromCreate(i)">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      }
      @if (createForm().items.length === 0) {
      <p class="week-items-empty">No items yet. Add items to track your weekly progress.</p>
      }
    </div>

    @if (createTaskCount() > 0) {
    <div class="week-items-task-summary">
      <span class="material-symbols-outlined">check_circle</span>
      <span><strong>{{ createTaskCount() }}</strong> {{ createTaskCount() === 1 ? 'item' : 'items' }} will also be
        created as Tasks</span>
    </div>
    }

    <div class="form-group">
      <label>
        <span class="material-symbols-outlined">rate_review</span>
        Reflection <span class="form-group__optional">optional</span>
      </label>
      <textarea rows="3" placeholder="Add a reflection at the end of the week..."
        [(ngModel)]="createForm().reflection"></textarea>
    </div>

    <div class="weekplan-modal__footer">
      <button class="btn-secondary" (click)="showCreateModal.set(false)">Cancel</button>
      <button class="btn-primary" (click)="submitCreate()">Create Week Plan</button>
    </div>
  </div>
</div>
}

<!-- ══ EDIT MODAL ════════════════════════════════════════ -->
@if (showEditModal() && selectedPlan()) {
<div class="modal-overlay" (click)="showEditModal.set(false); showEditCatDropdown.set(false)">
  <div class="weekplan-modal" (click)="$event.stopPropagation(); showEditCatDropdown.set(false)">

    <div class="weekplan-modal__header">
      <div>
        <h2 class="weekplan-modal__title">Edit Week Plan</h2>
        <p class="weekplan-modal__subtitle">Update your week plan details.</p>
      </div>
      <div class="weekplan-modal__header-actions">
        <button class="weekplan-modal__action-btn weekplan-modal__action-btn--delete" (click)="openDeleteConfirm()"
          title="Delete week plan">
          <span class="material-symbols-outlined">delete</span>
        </button>
        <button class="weekplan-modal__close" (click)="showEditModal.set(false)">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
    </div>

    <input class="weekplan-modal__title-input" type="text" placeholder="Week Plan Title"
      [(ngModel)]="editForm().title" />

    <div class="form-group">
      <label>
        <span class="material-symbols-outlined">lightbulb</span>Intention
      </label>
      <textarea rows="2" placeholder="What is your focus and intention for this week?"
        [(ngModel)]="editForm().intention"></textarea>
    </div>

    <div class="weekplan-modal__row">
      <div class="form-group">
        <label>Start Date</label>
        <input type="date" [(ngModel)]="editForm().startDate" />
      </div>
      <div class="form-group">
        <label>End Date</label>
        <input type="date" [(ngModel)]="editForm().endDate" />
      </div>
    </div>

    <div class="form-group">
      <label>Status</label>
      <div class="modal-status-picker">
        @for (s of statuses; track s) {
        <button
          [class]="'modal-status-btn modal-status-btn--' + s.toLowerCase() + (editForm().status === s ? ' active' : '')"
          (click)="editForm.update(f => ({ ...f, status: s }))">
          <span class="material-symbols-outlined">{{ getStatusIcon(s) }}</span>
          {{ getStatusLabel(s) }}
        </button>
        }
      </div>
    </div>

    <!-- Categories Dropdown -->
    <div class="form-group" (click)="$event.stopPropagation()">
      <label>Categories</label>
      <div class="modal-cat-dropdown">
        <button class="modal-cat-dropdown__trigger"
          [class.modal-cat-dropdown__trigger--active]="editForm().categoryIds.length > 0"
          [class.modal-cat-dropdown__trigger--open]="showEditCatDropdown()" (click)="toggleEditCatDropdown($event)">
          <div class="modal-cat-dropdown__trigger-left">
            @if (editForm().categoryIds.length > 0) {
            <div class="modal-cat-dropdown__dots">
              @for (color of getSelectedCatColors(editForm().categoryIds); track color) {
              <span class="modal-cat-dropdown__dot" [style.background]="color"></span>
              }
            </div>
            }
            <span class="modal-cat-dropdown__label">
              {{ getCatDropdownLabel(editForm().categoryIds) }}
            </span>
          </div>
          <span class="material-symbols-outlined modal-cat-dropdown__arrow">
            {{ showEditCatDropdown() ? 'expand_less' : 'expand_more' }}
          </span>
        </button>
        @if (showEditCatDropdown()) {
        <div class="modal-cat-dropdown__menu">
          @for (cat of availableCategories(); track cat.id) {
          <button class="modal-cat-dropdown__item"
            [class.modal-cat-dropdown__item--selected]="editForm().categoryIds.includes(cat.id)"
            (click)="toggleEditCategory(cat.id)">
            <div class="modal-cat-dropdown__item-check">
              @if (editForm().categoryIds.includes(cat.id)) {
              <span class="material-symbols-outlined">check</span>
              }
            </div>
            <span class="material-symbols-outlined modal-cat-dropdown__item-icon" [style.color]="cat.color">{{ cat.icon
              }}</span>
            <span class="modal-cat-dropdown__item-label">{{ cat.name }}</span>
          </button>
          }
          @if (editForm().categoryIds.length > 0) {
          <div class="modal-cat-dropdown__footer">
            <button class="modal-cat-dropdown__clear"
              (click)="editForm.update(f => ({ ...f, categoryIds: [] })); $event.stopPropagation()">
              <span class="material-symbols-outlined">close</span>Clear
            </button>
          </div>
          }
        </div>
        }
      </div>
    </div>

    <!-- Weekly Items -->
    <div class="weekplan-modal__section-label">
      <span class="material-symbols-outlined">checklist</span>
      Weekly Items
      <div class="weekplan-modal__section-actions">
        @if (editForm().items.length > 0) {
        <button class="weekplan-modal__convert-all-btn" (click)="convertAllToTasks('edit')"
          title="Mark all items as tasks">
          <span class="material-symbols-outlined">check_circle</span>All as tasks
        </button>
        }
        <button class="weekplan-modal__add-item-btn" (click)="addItemToEdit()">
          <span class="material-symbols-outlined">add</span>Add Item
        </button>
      </div>
    </div>

    <div class="week-items-list">
      @for (item of editForm().items; track $index; let i = $index) {
      <div class="week-item-row" [class.week-item-row--task]="item.createAsTask">
        <div class="week-item-row__check">
          <input type="checkbox" [checked]="item.done"
            (change)="updateEditItem(i, 'done', $any($event.target).checked)" />
        </div>
        <input type="text" class="week-item-row__title" [class.week-item-row__title--done]="item.done"
          placeholder="Item title..." [value]="item.title"
          (input)="updateEditItem(i, 'title', $any($event.target).value)" />
        <input type="date" class="week-item-row__date" [value]="item.dueDate"
          (input)="updateEditItem(i, 'dueDate', $any($event.target).value)" />
        <button class="week-item-row__task-toggle" [class.week-item-row__task-toggle--active]="item.createAsTask"
          (click)="toggleCreateAsTask(i, 'edit')"
          [title]="item.createAsTask ? 'Will be created as Task' : 'Also create as Task'">
          <span class="material-symbols-outlined">check_circle</span>
        </button>
        <button class="week-item-row__remove" (click)="removeItemFromEdit(i)">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      }
      @if (editForm().items.length === 0) {
      <p class="week-items-empty">No items yet. Add items to track your weekly progress.</p>
      }
    </div>

    @if (editTaskCount() > 0) {
    <div class="week-items-task-summary">
      <span class="material-symbols-outlined">check_circle</span>
      <span><strong>{{ editTaskCount() }}</strong> {{ editTaskCount() === 1 ? 'item' : 'items' }} will also be created
        as Tasks</span>
    </div>
    }

    <div class="form-group">
      <label>
        <span class="material-symbols-outlined">rate_review</span>
        Reflection <span class="form-group__optional">optional</span>
      </label>
      <textarea rows="4" placeholder="How did this week go? What did you learn?"
        [(ngModel)]="editForm().reflection"></textarea>
    </div>

    <div class="weekplan-modal__footer">
      <button class="btn-secondary" (click)="showEditModal.set(false)">Cancel</button>
      <button class="btn-primary" (click)="submitEdit()">Save Changes</button>
    </div>
  </div>
</div>
}

<!-- ══ DELETE CONFIRM ════════════════════════════════════ -->
@if (showDeleteConfirm() && selectedPlan()) {
<div class="modal-overlay" (click)="showDeleteConfirm.set(false)">
  <div class="confirm-dialog" (click)="$event.stopPropagation()">
    <div class="confirm-dialog__icon confirm-dialog__icon--danger">
      <span class="material-symbols-outlined">delete</span>
    </div>
    <h3 class="confirm-dialog__title">Delete Week Plan</h3>
    <p class="confirm-dialog__text">
      Are you sure you want to delete <strong>"{{ selectedPlan()!.title }}"</strong>?
      This action cannot be undone.
    </p>
    <div class="confirm-dialog__actions">
      <button class="btn-secondary" (click)="showDeleteConfirm.set(false)">Cancel</button>
      <button class="btn-danger" (click)="confirmDelete()">Delete Week Plan</button>
    </div>
  </div>
</div>
}
