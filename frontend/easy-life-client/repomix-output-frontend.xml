<file path="src/app/pages/workspace/notifications/notifications.scss">
@use '../../../../styles/variables' as *;
@use '../../../../styles/mixins' as *;

// ── Header ─────────────────────────────────────────────────
.notif-header {
  @include flex-between;
  margin-bottom: $space-6;
  gap: $space-4;
  flex-wrap: wrap;

  &__text {
    @include flex-col;
    gap: $space-1;
  }

  &__label {
    font-size: $font-size-xs;
    font-weight: $font-weight-semibold;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  &__subtitle {
    font-size: $font-size-sm;
    color: var(--color-text-secondary);
  }

  .notif-header__actions {
    @include flex-start;
    gap: $space-3;
  }
}

// ── Stats Row ──────────────────────────────────────────────
.notif-stats {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: $space-4;
  margin-bottom: $space-6;
  align-items: stretch;

  @include below-md {
    grid-template-columns: 1fr;
  }
}

// ── Unread Card ────────────────────────────────────────────
.notif-unread {
  @include card($space-5);
  @include flex-col;
  gap: $space-3;

  &__label {
    @include section-label;
  }

  &__value {
    @include flex-start;
    align-items: baseline;
    gap: $space-2;
  }

  &__num {
    font-size: $font-size-3xl;
    font-weight: $font-weight-bold;
    color: var(--color-primary);
    line-height: 1;
  }

  &__sub {
    font-size: $font-size-xs;
    color: var(--color-text-muted);
  }
}

// ── Filter Chips ───────────────────────────────────────────
.notif-filter-chips {
  @include card($space-5);
  @include flex-start;
  gap: $space-2;
  flex-wrap: wrap;
  align-items: center;
}

.notif-chip {
  @include flex-start;
  gap: $space-2;
  padding: $space-2 $space-4;
  border-radius: $radius-pill;
  border: 1px solid var(--color-border);
  background: var(--color-bg-card);
  font-family: $font-family;
  font-size: $font-size-sm;
  font-weight: $font-weight-medium;
  color: var(--color-text-secondary);
  cursor: pointer;
  transition: all $transition-fast;
  position: relative;

  .material-symbols-outlined {
    font-size: 16px;
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
  }

  &__badge {
    background: var(--color-danger);
    color: white;
    font-size: 10px;
    font-weight: $font-weight-bold;
    padding: 1px 5px;
    border-radius: $radius-pill;
    margin-left: 2px;
  }

  &:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: var(--color-primary-light);
  }

  &--active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;

    .material-symbols-outlined {
      font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 20;
    }

    .notif-chip__badge {
      background: white;
      color: var(--color-primary);
    }

    &:hover {
      background: var(--color-primary-hover);
      color: white;
    }
  }

  &--reminder:not(.notif-chip--active):hover {
    border-color: var(--color-reminder);
    color: var(--color-reminder-text);
    background: var(--color-reminder-subtle);
  }

  &--warning:not(.notif-chip--active):hover {
    border-color: var(--color-warning);
    color: var(--color-warning-text);
    background: var(--color-warning-subtle);
  }

  &--success:not(.notif-chip--active):hover {
    border-color: var(--color-success);
    color: var(--color-success-text);
    background: var(--color-success-subtle);
  }

  &--info:not(.notif-chip--active):hover {
    border-color: var(--color-info);
    color: var(--color-info-text);
    background: var(--color-info-subtle);
  }
}

// ── Container ──────────────────────────────────────────────
.notif-container {
  @include card(0);
  overflow: hidden;
}

.notif-list__header {
  @include flex-between;
  padding: $space-4 $space-6;
  border-bottom: 1px solid var(--color-border-light);
}

.notif-list__section-title {
  font-size: $font-size-sm;
  font-weight: $font-weight-semibold;
  color: var(--color-text-secondary);
}

// ── Notification Item ──────────────────────────────────────
.notif-item {
  @include flex-start;
  gap: $space-4;
  padding: $space-5 $space-6;
  border-bottom: 1px solid var(--color-border-light);
  cursor: pointer;
  transition: background $transition-fast;
  align-items: flex-start;

  &:last-of-type {
    border-bottom: none;
  }

  &:hover {
    background: var(--color-bg-hover);
  }

  &--unread {
    background: var(--color-primary-subtle);
    border-left: 3px solid var(--color-primary);
    padding-left: calc(#{$space-6} - 3px);
  }

  &__icon {
    width: 40px;
    height: 40px;
    border-radius: $radius-md;
    @include flex-center;
    flex-shrink: 0;

    .material-symbols-outlined {
      font-size: 20px;
      font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 20;
    }

    &.type--reminder {
      background: var(--color-reminder-subtle);
      color: var(--color-reminder-text);
    }

    &.type--info {
      background: var(--color-info-subtle);
      color: var(--color-info-text);
    }

    &.type--warning {
      background: var(--color-warning-subtle);
      color: var(--color-warning-text);
    }

    &.type--success {
      background: var(--color-success-subtle);
      color: var(--color-success-text);
    }
  }

  &__content {
    @include flex-col;
    gap: $space-2;
    flex: 1;
    min-width: 0;
  }

  &__top {
    @include flex-between;
    gap: $space-4;
    align-items: flex-start;
  }

  &__title {
    font-size: $font-size-sm;
    font-weight: $font-weight-semibold;
    color: var(--color-text-primary);
    flex: 1;
    min-width: 0;
  }

  &__meta {
    @include flex-start;
    gap: $space-2;
    flex-shrink: 0;
  }

  &__ref-badge {
    font-size: $font-size-xs;
    font-weight: $font-weight-semibold;
    color: var(--color-text-muted);
    background: var(--color-bg-input);
    padding: 2px $space-2;
    border-radius: $radius-pill;
    border: 1px solid var(--color-border);
  }

  &__dot {
    width: 8px;
    height: 8px;
    border-radius: $radius-full;
    background: var(--color-primary);
    flex-shrink: 0;
    margin-top: 3px;
  }

  &__message {
    font-size: $font-size-sm;
    color: var(--color-text-secondary);
    line-height: 1.6;
    @include truncate(2);
  }

  &__footer {
    @include flex-between;
    align-items: center;
    margin-top: $space-1;
  }

  &__action {
    @include flex-start;
    gap: $space-1;
    font-family: $font-family;
    font-size: $font-size-xs;
    font-weight: $font-weight-semibold;
    color: var(--color-primary);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: gap $transition-fast;

    .material-symbols-outlined {
      font-size: 14px;
    }

    &:hover {
      gap: $space-2;
    }
  }

  &__time {
    font-size: $font-size-xs;
    color: var(--color-text-muted);
  }
}

// ══ MODAL OVERLAY ════════════════════════════════════════
.modal-overlay {
  position: fixed;
  inset: 0;
  background: var(--color-overlay);
  backdrop-filter: blur(4px);
  z-index: 200;
  @include flex-center;
  padding: $space-4;
}

// ══ NOTIFICATION MODAL ════════════════════════════════════
.notif-modal {
  background: var(--color-bg-card);
  border-radius: $radius-xl;
  box-shadow: var(--shadow-lg);
  width: 100%;
  max-width: 580px;
  max-height: 90vh;
  overflow-y: auto;
  @include scrollbar-thin;
  @include flex-col;
  gap: $space-5;
  padding: $space-8;

  &__header {
    @include flex-between;
    align-items: flex-start;
    gap: $space-4;
  }

  &__header-type {
    @include flex-start;
    gap: $space-4;
    align-items: center;
    flex: 1;
    min-width: 0;
  }

  &__type-icon {
    width: 44px;
    height: 44px;
    border-radius: $radius-md;
    @include flex-center;
    flex-shrink: 0;

    .material-symbols-outlined {
      font-size: 22px;
      font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 20;
    }

    &.type--reminder {
      background: var(--color-reminder-subtle);
      color: var(--color-reminder-text);
    }

    &.type--info {
      background: var(--color-info-subtle);
      color: var(--color-info-text);
    }

    &.type--warning {
      background: var(--color-warning-subtle);
      color: var(--color-warning-text);
    }

    &.type--success {
      background: var(--color-success-subtle);
      color: var(--color-success-text);
    }
  }

  &__header-actions {
    @include flex-start;
    gap: $space-2;
  }

  &__title {
    font-size: $font-size-xl;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
  }

  &__subtitle {
    font-size: $font-size-sm;
    color: var(--color-text-muted);
    margin-top: 2px;
  }

  &__close {
    @include btn-ghost;
    border-radius: $radius-md;
    padding: $space-1;
    flex-shrink: 0;

    .material-symbols-outlined {
      font-size: 22px;
    }
  }

  &__action-btn {
    width: 36px;
    height: 36px;
    border-radius: $radius-md;
    border: none;
    @include flex-center;
    cursor: pointer;
    transition: all $transition-fast;

    .material-symbols-outlined {
      font-size: 18px;
    }

    &--delete {
      background: var(--color-danger-subtle);
      color: var(--color-danger);

      &:hover {
        background: var(--color-danger-subtle);
        filter: brightness(0.9);
      }
    }
  }

  &__title-input {
    width: 100%;
    border: none;
    border-bottom: 2px solid var(--color-border);
    padding: $space-2 0;
    font-family: $font-family;
    font-size: $font-size-xl;
    font-weight: $font-weight-semibold;
    color: var(--color-text-primary);
    background: transparent;
    outline: none;
    transition: border-color $transition-fast;

    &::placeholder {
      color: var(--color-text-muted);
    }

    &:focus {
      border-color: var(--color-primary);
    }
  }

  &__section-label {
    @include flex-start;
    gap: $space-2;
    font-size: $font-size-xs;
    font-weight: $font-weight-bold;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: $space-2 0 $space-1;
    border-top: 1px solid var(--color-border-light);

    .material-symbols-outlined {
      font-size: 15px;
      color: var(--color-primary);
    }
  }

  &__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: $space-4;

    @include below-md {
      grid-template-columns: 1fr;
    }
  }

  &__footer {
    @include flex-between;
    padding-top: $space-4;
    border-top: 1px solid var(--color-border-light);
  }
}

// ── Type Picker ────────────────────────────────────────────
.notif-type-picker {
  @include flex-start;
  gap: $space-2;
  flex-wrap: wrap;
}

.notif-type-btn {
  @include flex-start;
  gap: $space-2;
  padding: $space-1 $space-3;
  border-radius: $radius-pill;
  border: 1px solid var(--color-border);
  background: var(--color-bg-card);
  font-family: $font-family;
  font-size: $font-size-xs;
  font-weight: $font-weight-medium;
  color: var(--color-text-muted);
  cursor: pointer;
  transition: all $transition-fast;

  .material-symbols-outlined {
    font-size: 14px;
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
  }

  &:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  &--reminder.active {
    background: var(--color-reminder-subtle);
    color: var(--color-reminder-text);
    border-color: var(--color-reminder-border);
  }

  &--info.active {
    background: var(--color-info-subtle);
    color: var(--color-info-text);
    border-color: var(--color-info-border);
  }

  &--warning.active {
    background: var(--color-warning-subtle);
    color: var(--color-warning-text);
    border-color: var(--color-warning-border);
  }

  &--success.active {
    background: var(--color-success-subtle);
    color: var(--color-success-text);
    border-color: var(--color-success-border);
  }
}

// ── Channel Picker ─────────────────────────────────────────
.notif-channel-picker {
  @include flex-start;
  border: 1px solid var(--color-border);
  border-radius: $radius-md;
  overflow: hidden;
}

.notif-channel-btn {
  @include flex-start;
  gap: $space-2;
  flex: 1;
  padding: $space-2 $space-3;
  border: none;
  background: none;
  font-family: $font-family;
