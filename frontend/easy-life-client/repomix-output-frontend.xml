      </p>
    </div>
    <div class="nprofile-hero__actions">
      @if (profile.followStatus === 'FOLLOWING') {
      <button class="btn-secondary nprofile-follow-btn nprofile-follow-btn--following" (click)="toggleFollow()">
        <span class="material-symbols-outlined">how_to_reg</span>
        Following
      </button>
      } @else {
      <button class="btn-primary nprofile-follow-btn" (click)="toggleFollow()">
        <span class="material-symbols-outlined">person_add</span>
        Follow
      </button>
      }
    </div>
  </div>

  <!-- Tabs -->
  <div class="nprofile-tabs">
    <button [class]="'nprofile-tab ' + (activeTab() === 'goals' ? 'nprofile-tab--active' : '')"
      (click)="activeTab.set('goals')">
      <span class="material-symbols-outlined">flag</span>
      Goals
      <span class="nprofile-tab__count">{{ goals.length }}</span>
    </button>
    <button [class]="'nprofile-tab ' + (activeTab() === 'categories' ? 'nprofile-tab--active' : '')"
      (click)="activeTab.set('categories')">
      <span class="material-symbols-outlined">category</span>
      Categories
      <span class="nprofile-tab__count">{{ categories.length }}</span>
    </button>
    <button [class]="'nprofile-tab ' + (activeTab() === 'contacts' ? 'nprofile-tab--active' : '')"
      (click)="activeTab.set('contacts')">
      <span class="material-symbols-outlined">people</span>
      Contacts
      <span class="nprofile-tab__count">{{ contacts.length }}</span>
    </button>
  </div>

  <!-- Goals Tab -->
  @if (activeTab() === 'goals') {
  <div class="nprofile-goals">
    @for (goal of goals; track goal.id) {
    <div class="nprofile-goal-card">
      <div class="nprofile-goal-card__icon" [style.background]="goal.color + '18'">
        <span class="material-symbols-outlined" [style.color]="goal.color">{{ goal.icon }}</span>
      </div>
      <div class="nprofile-goal-card__info">
        <div class="nprofile-goal-card__title-row">
          <h3 class="nprofile-goal-card__title">{{ goal.title }}</h3>
          <span [class]="'nprofile-goal-card__status nprofile-goal-card__status--' + goal.status.toLowerCase()">
