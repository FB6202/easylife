}

// ══ DOCUMENT MODAL ════════════════════════════════════════
.doc-modal {
  background: var(--color-bg-card);
  border-radius: $radius-xl;
  box-shadow: var(--shadow-lg);
  width: 100%;
  max-width: 560px;
  max-height: 90vh;
  overflow-y: auto;
  @include scrollbar-thin;
  @include flex-col;
  gap: $space-5;
  padding: $space-8;

  &__header {
    @include flex-between;
    align-items: flex-start;
    gap: $space-4;
  }

  &__header-actions {
    @include flex-start;
    gap: $space-2;
