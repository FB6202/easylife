  <!-- Following Widget -->
  @if (isWidgetEnabled('following')) {
  <div class="dash-widget dash-widget--following" (click)="navigateTo('following')">
    <div class="dash-widget__header">
      <div class="dash-widget__header-left">
        <div class="dash-widget__icon-wrap dash-widget__icon-wrap--following">
          <span class="material-symbols-outlined">person_add</span>
        </div>
        <div>
          <p class="dash-widget__title">Network</p>
          <p class="dash-widget__subtitle">{{ followingStats.following }} following · {{ followingStats.followers }}
            followers</p>
        </div>
      </div>
      <span class="material-symbols-outlined dash-widget__arrow">arrow_forward</span>
    </div>
    <div class="dash-widget__list">
      <div class="dash-following-stats">
        <div class="dash-following-stat">
          <span class="dash-following-stat__num">{{ followingStats.following }}</span>
          <span class="dash-following-stat__label">Following</span>
        </div>
        <div class="dash-following-stat">
          <span class="dash-following-stat__num">{{ followingStats.followers }}</span>
          <span class="dash-following-stat__label">Followers</span>
        </div>
        <div class="dash-following-stat dash-following-stat--pending">
          <span class="dash-following-stat__num">{{ followingStats.pendingRequests }}</span>
          <span class="dash-following-stat__label">Pending</span>
        </div>
      </div>
      <button class="dash-following-search" (click)="$event.stopPropagation(); navigateTo('network/search')">
        <span class="material-symbols-outlined">person_search</span>
        Find People
      </button>
    </div>
  </div>
  }

  <!-- Empty State wenn alle deaktiviert -->
  @if (enabledCount() === 0) {
  <div class="dash-empty">
    <span class="material-symbols-outlined">dashboard_customize</span>
    <p class="dash-empty__title">No widgets enabled</p>
    <p class="dash-empty__text">Click "Widgets" above to add widgets to your dashboard.</p>
  </div>
  }

</div>
</file>

<file path="src/app/pages/workspace/dashboard/dashboard.scss">
@use '../../../../styles/variables' as *;
@use '../../../../styles/mixins' as *;

// ── Greeting ───────────────────────────────────────────────
.dash-greeting {
  @include flex-between;
  margin-bottom: $space-6;
  gap: $space-4;
  flex-wrap: wrap;
  align-items: flex-end;

  &__text {
    @include flex-col;
    gap: $space-2;
  }

  &__label {
    font-size: $font-size-xs;
    font-weight: $font-weight-semibold;
    color: var(--color-primary);
    letter-spacing: 0.1em;
  }

  &__title {
    font-size: $font-size-4xl;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
    @include flex-start;
    gap: $space-3;
    align-items: center;
    flex-wrap: wrap;
  }

  &__icon {
    font-size: 32px;
    color: var(--color-primary);
    font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 32;
  }

  &__subtitle {
    font-size: $font-size-base;
    color: var(--color-text-secondary);
    max-width: 520px;
  }

  &__meta {
    @include flex-start;
    gap: $space-2;
    font-size: $font-size-sm;
    color: var(--color-text-muted);
    white-space: nowrap;

    .material-symbols-outlined {
      font-size: 16px;
    }
  }
}

.dash-greeting__right {
  @include flex-col;
  align-items: flex-end;
  gap: $space-3;
}

.dash-actions {
  @include flex-start;
  gap: $space-3;
  align-items: center;
}

// ── AI Button ──────────────────────────────────────────────
.dash-ai-btn {
  @include flex-start;
  gap: $space-2;
  padding: $space-2 $space-5;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: white;
  border: none;
  border-radius: $radius-pill;
  font-family: $font-family;
  font-size: $font-size-sm;
  font-weight: $font-weight-semibold;
  cursor: pointer;
  transition: all $transition-base;
  box-shadow: 0 2px 12px rgba(99, 102, 241, 0.3);

  .material-symbols-outlined {
    font-size: 18px;
    font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 20;
    animation: pulse-star 2s ease-in-out infinite;
  }

  &:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(99, 102, 241, 0.45);
  }

  &:active {
    transform: translateY(0);
  }
}

@keyframes pulse-star {

  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }

  50% {
    opacity: 0.85;
    transform: scale(1.12);
  }
}

// ── Widget Manager ─────────────────────────────────────────
.widget-manager {
  position: relative;
  z-index: 50;

  &__trigger {
    @include flex-start;
    gap: $space-2;
    padding: $space-2 $space-4;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: $radius-pill;
    font-family: $font-family;
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all $transition-fast;

    .material-symbols-outlined {
      font-size: 18px;
    }

    &:hover {
      border-color: var(--color-primary);
      color: var(--color-primary);
      background: var(--color-primary-light);
    }

    &--active {
      border-color: var(--color-primary);
      color: var(--color-primary);
      background: var(--color-primary-light);
    }
  }

  &__count {
    background: var(--color-primary);
    color: white;
    font-size: 11px;
    font-weight: $font-weight-bold;
    padding: 1px 6px;
    border-radius: $radius-pill;
    margin-left: 2px;
  }

  &__arrow {
    font-size: 16px;
    color: var(--color-primary);
    transition: transform $transition-fast;
  }

  &__panel {
    position: absolute;
    top: calc(100% + $space-2);
    right: 0;
    width: 280px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: $radius-xl;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    animation: dropdown-open 0.15s ease-out;
    z-index: 100;

    @keyframes dropdown-open {
      from {
        opacity: 0;
        transform: translateY(-6px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  &__panel-header {
    @include flex-start;
    gap: $space-2;
    padding: $space-4 $space-5;
    font-size: $font-size-xs;
    font-weight: $font-weight-bold;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-bottom: 1px solid var(--color-border-light);

    .material-symbols-outlined {
      font-size: 15px;
      color: var(--color-primary);
    }
  }

  &__list {
    @include flex-col;
    max-height: 340px;
    overflow-y: auto;
    @include scrollbar-thin;
  }

  &__item {
    @include flex-between;
    padding: $space-3 $space-5;
    cursor: pointer;
    transition: background $transition-fast;
    border-bottom: 1px solid var(--color-border-light);

    &:last-child {
      border-bottom: none;
    }

    &:hover {
      background: var(--color-bg-hover);
    }

    &--enabled {
      .widget-manager__item-label {
        color: var(--color-text-primary);
        font-weight: $font-weight-medium;
      }
    }
  }

  &__item-left {
    @include flex-start;
    gap: $space-3;
  }

  &__item-icon {
    width: 32px;
    height: 32px;
    border-radius: $radius-md;
    background: var(--color-bg-input);
    @include flex-center;
    transition: all $transition-fast;

    .material-symbols-outlined {
      font-size: 16px;
      color: var(--color-text-muted);
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
    }

    &--enabled {
      background: var(--color-primary-light);

      .material-symbols-outlined {
        color: var(--color-primary);
        font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 20;
      }
    }
  }

  &__item-label {
    font-size: $font-size-sm;
    color: var(--color-text-muted);
    transition: color $transition-fast;
  }

  &__toggle {
    width: 36px;
    height: 20px;
    border-radius: $radius-pill;
    background: var(--color-border);
    position: relative;
    transition: background $transition-base;
    flex-shrink: 0;

    &--on {
      background: var(--color-primary);
    }
  }

  &__toggle-knob {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: $radius-full;
    background: white;
    top: 3px;
    left: 3px;
    transition: transform $transition-base;
    box-shadow: var(--shadow-sm);

    .widget-manager__toggle--on & {
      transform: translateX(16px);
    }
  }

  &__panel-footer {
    @include flex-start;
    gap: $space-2;
    padding: $space-3 $space-5;
    font-size: $font-size-xs;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border-light);
    background: var(--color-bg-input);

    .material-symbols-outlined {
      font-size: 14px;
    }
  }
}

.widget-manager-overlay {
  position: fixed;
  inset: 0;
  z-index: 49;
}

// ── Grid ───────────────────────────────────────────────────
.dash-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: $space-5;

  @media (max-width: 1200px) {
    grid-template-columns: repeat(2, 1fr);
  }

  @include below-md {
    grid-template-columns: 1fr;
  }
}

// ── Widget Base ────────────────────────────────────────────
.dash-widget {
  @include card($space-5);
  @include flex-col;
  gap: $space-4;
  cursor: pointer;
  transition: box-shadow $transition-base, transform $transition-base;

  &:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  &__header {
    @include flex-between;
    align-items: center;
    gap: $space-3;
  }

  &__header-left {
    @include flex-start;
    gap: $space-3;
    align-items: center;
    min-width: 0;
  }

  &__icon-wrap {
    width: 40px;
    height: 40px;
    border-radius: $radius-md;
    @include flex-center;
    flex-shrink: 0;

    .material-symbols-outlined {
      font-size: 20px;
      font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 20;
    }

    &--tasks {
      background: var(--color-success-subtle);
      color: var(--color-primary);
    }

    &--calendar {
      background: var(--color-info-subtle);
      color: var(--color-info);
    }

    &--goals {
      background: var(--color-warning-subtle);
      color: var(--color-warning);
    }

    &--weekplan {
      background: var(--color-purple-subtle);
      color: #9c27b0;
    }

    &--categories {
      background: var(--color-teal-subtle);
      color: #00bcd4;
    }

    &--notifications {
      background: var(--color-pink-subtle);
      color: #e91e63;
    }

    &--journal {
      background: rgba(121, 85, 72, 0.12);
      color: #795548;
    }

    &--network {
      background: var(--color-info-subtle);
      color: var(--color-info);
    }

    &--following {
      background: var(--color-purple-subtle);
      color: #9c27b0;
    }
  }

  &__title {
    font-size: $font-size-base;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
  }

  &__subtitle {
    font-size: $font-size-xs;
    color: var(--color-text-muted);
    margin-top: 1px;
  }

  &__arrow {
    font-size: 18px;
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition: transform $transition-fast, color $transition-fast;
  }

  &:hover &__arrow {
    transform: translateX(3px);
    color: var(--color-primary);
  }

  &__list {
    @include flex-col;
    gap: $space-3;
  }

  &--tasks {
    border-top: 3px solid var(--color-primary);
  }

  &--calendar {
    border-top: 3px solid var(--color-info);
  }

  &--goals {
    border-top: 3px solid var(--color-warning);
  }

  &--weekplan {
    border-top: 3px solid #9c27b0;
  }

  &--categories {
    border-top: 3px solid #00bcd4;
  }

  &--notifications {
    border-top: 3px solid #e91e63;
  }

  &--journal {
    border-top: 3px solid #795548;
  }

  &--network {
    border-top: 3px solid var(--color-info);
  }

  &--following {
    border-top: 3px solid #9c27b0;
  }
}

// ── Task Items ─────────────────────────────────────────────
.dash-task-item {
  @include flex-start;
  gap: $space-3;
  padding: $space-3;
  background: var(--color-bg-input);
  border-radius: $radius-md;
  align-items: flex-start;

  &__status {
    font-size: 18px;
    flex-shrink: 0;
    margin-top: 1px;
    font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 20;

    &.status--open {
      color: var(--color-text-muted);
    }

    &.status--in-progress {
      color: var(--color-reminder);
    }

    &.status--done {
      color: var(--color-primary);
    }
  }

  &__info {
    @include flex-col;
    gap: 3px;
    flex: 1;
    min-width: 0;
  }

  &__title {
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    color: var(--color-text-primary);
    @include truncate;
  }

  &__due {
    font-size: $font-size-xs;
    font-weight: $font-weight-medium;

    &--overdue {
      color: var(--color-danger);
    }

    &--today {
      color: var(--color-warning);
    }

    &--soon {
      color: var(--color-text-muted);
    }

    &--normal {
      color: var(--color-text-muted);
    }
  }

  &__priority {
    font-size: 10px;
    font-weight: $font-weight-bold;
    padding: 2px $space-2;
    border-radius: $radius-pill;
    flex-shrink: 0;

    &.priority--critical {
      background: var(--color-priority-critical-subtle);
      color: var(--color-priority-critical-text);
    }

    &.priority--high {
      background: var(--color-priority-high-subtle);
      color: var(--color-priority-high-text);
    }

    &.priority--medium {
      background: var(--color-priority-medium-subtle);
      color: var(--color-priority-medium-text);
    }

    &.priority--low {
      background: var(--color-priority-low-subtle);
      color: var(--color-priority-low-text);
    }

    &.priority--optional {
      background: var(--color-priority-optional-subtle);
      color: var(--color-priority-optional-text);
    }
  }
}

// ── Event Items ────────────────────────────────────────────
.dash-event-item {
  @include flex-start;
  gap: $space-3;
  align-items: stretch;

  &__bar {
    width: 3px;
    border-radius: $radius-pill;
    flex-shrink: 0;
    min-height: 40px;
  }

  &__info {
    @include flex-col;
    gap: $space-1;
    flex: 1;
    min-width: 0;
  }

  &__title {
    font-size: $font-size-sm;
    font-weight: $font-weight-semibold;
    color: var(--color-text-primary);
    @include truncate;
  }

  &__meta {
    @include flex-start;
    gap: $space-3;
    flex-wrap: wrap;
  }

  &__time,
  &__location {
    @include flex-start;
    gap: $space-1;
    font-size: $font-size-xs;
    color: var(--color-text-muted);

    .material-symbols-outlined {
      font-size: 12px;
    }
  }
}

// ── Goal Items ─────────────────────────────────────────────
.dash-goal-item {
  @include flex-start;
  gap: $space-3;
  align-items: flex-start;

  &__icon {
    font-size: 22px;
    flex-shrink: 0;
    margin-top: 2px;
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }

  &__info {
    @include flex-col;
    gap: $space-2;
    flex: 1;
    min-width: 0;
  }

  &__title-row {
    @include flex-between;
    gap: $space-2;
  }

  &__title {
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    color: var(--color-text-primary);
    @include truncate;
  }

  &__pct {
    font-size: $font-size-sm;
    font-weight: $font-weight-bold;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  &__bar {
    height: 4px;
    border-radius: $radius-pill;
  }

  &__deadline {
    @include flex-start;
    gap: $space-1;
    font-size: $font-size-xs;
    color: var(--color-text-muted);

    .material-symbols-outlined {
      font-size: 12px;
    }
  }
}

// ── Week Plan ──────────────────────────────────────────────
.dash-weekplan-body {
  @include flex-col;
  gap: $space-3;
  padding: $space-4;
  background: var(--color-bg-input);
  border-radius: $radius-md;

  &__status-row {
    @include flex-between;
    align-items: center;
  }

  &__status {
    @include flex-start;
    gap: $space-1;
    font-size: $font-size-xs;
    font-weight: $font-weight-bold;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.06em;

    .material-symbols-outlined {
      font-size: 14px;
      font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 20;
    }
  }

  &__items {
    font-size: $font-size-xs;
    font-weight: $font-weight-semibold;
    color: var(--color-text-muted);
  }

  &__title {
    font-size: $font-size-base;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
    @include truncate;
  }

  &__intention {
    font-size: $font-size-xs;
    color: var(--color-text-secondary);
    font-style: italic;
    @include truncate(2);
    line-height: 1.5;
  }

  &__progress {
    @include flex-col;
    gap: $space-2;
  }

  &__progress-info {
    @include flex-between;
    font-size: $font-size-xs;
    color: var(--color-text-muted);
  }

  &__pct {
    font-weight: $font-weight-bold;
    color: var(--color-primary);
  }
}

// ── Category Items ─────────────────────────────────────────
.dash-cat-item {
  @include flex-start;
  gap: $space-3;
  align-items: center;

  &__icon {
    width: 36px;
    height: 36px;
    border-radius: $radius-md;
    @include flex-center;
    flex-shrink: 0;

    .material-symbols-outlined {
      font-size: 18px;
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
    }
  }

  &__info {
    @include flex-col;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  &__name {
    font-size: $font-size-sm;
    font-weight: $font-weight-semibold;
    color: var(--color-text-primary);
    @include truncate;
  }

  &__count {
    font-size: $font-size-xs;
    color: var(--color-text-muted);
  }

  &__bar-wrap {
    width: 4px;
    height: 36px;
    border-radius: $radius-pill;
    overflow: hidden;
    flex-shrink: 0;
  }

  &__bar {
    width: 100%;
    height: 100%;
    border-radius: $radius-pill;
    opacity: 0.5;
  }
}

// ── Notification Items ─────────────────────────────────────
.dash-notif-badge {
  background: var(--color-pink-text);
  color: white;
  font-size: 11px;
  font-weight: $font-weight-bold;
  padding: 2px $space-2;
  border-radius: $radius-pill;
  min-width: 20px;
  text-align: center;
  flex-shrink: 0;
}

.dash-notif-item {
  @include flex-start;
  gap: $space-3;
  padding: $space-3;
  border-radius: $radius-md;
  transition: background $transition-fast;
  align-items: flex-start;
  position: relative;

  &--unread {
    background: var(--color-bg-input);
  }

  &__icon {
    width: 32px;
    height: 32px;
    border-radius: $radius-md;
    @include flex-center;
    flex-shrink: 0;

    .material-symbols-outlined {
      font-size: 16px;
      font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 20;
    }

    &.type--reminder {
      background: var(--color-reminder-subtle);
      color: var(--color-reminder-text);
    }

    &.type--info {
      background: var(--color-info-subtle);
      color: var(--color-info-text);
    }

    &.type--warning {
      background: var(--color-warning-subtle);
      color: var(--color-warning-text);
    }

    &.type--success {
      background: var(--color-success-subtle);
      color: var(--color-success-text);
    }
  }

  &__info {
    @include flex-col;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  &__title {
    font-size: $font-size-sm;
    font-weight: $font-weight-semibold;
    color: var(--color-text-primary);
    @include truncate;
  }

  &__msg {
    font-size: $font-size-xs;
    color: var(--color-text-secondary);
    @include truncate(2);
    line-height: 1.5;
  }

  &__time {
    font-size: $font-size-xs;
    color: var(--color-text-muted);
    margin-top: 2px;
  }

  &__dot {
    width: 8px;
    height: 8px;
    border-radius: $radius-full;
    background: var(--color-pink-text);
    flex-shrink: 0;
    margin-top: $space-1;
  }
}

// ── Journal Items ──────────────────────────────────────────
.dash-journal-item {
  @include flex-start;
  gap: $space-3;
  padding: $space-3;
  background: var(--color-bg-input);
  border-radius: $radius-md;
  align-items: flex-start;

  &__mood {
    font-size: 22px;
    flex-shrink: 0;
    font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }

  &__info {
    @include flex-col;
    gap: 3px;
    flex: 1;
    min-width: 0;
  }

  &__title {
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    color: var(--color-text-primary);
    @include truncate;
  }

  &__meta {
    font-size: $font-size-xs;
    color: var(--color-text-muted);
  }
}

// ── Contact Items ──────────────────────────────────────────
.dash-contact-item {
  @include flex-start;
  gap: $space-3;
  padding: $space-2;
  border-radius: $radius-md;
  transition: background $transition-fast;

  &:hover {
    background: var(--color-bg-input);
  }

  &__avatar {
    width: 36px;
    height: 36px;
    border-radius: $radius-full;
    @include flex-center;
    color: white;
    font-size: $font-size-xs;
    font-weight: $font-weight-bold;
    flex-shrink: 0;
  }

  &__info {
    @include flex-col;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  &__name {
    font-size: $font-size-sm;
    font-weight: $font-weight-semibold;
    color: var(--color-text-primary);
    @include truncate;
  }

  &__position {
    font-size: $font-size-xs;
    color: var(--color-text-muted);
    @include truncate;
  }
}

// ── Following Stats ────────────────────────────────────────
.dash-following-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: $space-3;
  padding: $space-4;
  background: var(--color-bg-input);
  border-radius: $radius-md;
}

.dash-following-stat {
  @include flex-col;
  align-items: center;
  gap: 2px;

  &__num {
    font-size: $font-size-2xl;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
    line-height: 1;
  }

  &__label {
    font-size: $font-size-xs;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  &--pending &__num {
    color: var(--color-warning);
  }
}

.dash-following-search {
  @include flex-center;
  gap: $space-2;
  width: 100%;
  padding: $space-3;
  background: none;
  border: 1px dashed var(--color-border);
  border-radius: $radius-md;
  font-family: $font-family;
  font-size: $font-size-sm;
  font-weight: $font-weight-medium;
  color: var(--color-text-muted);
  cursor: pointer;
  transition: all $transition-fast;

  .material-symbols-outlined {
    font-size: 18px;
  }

  &:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: var(--color-primary-light);
  }
}

// ── Empty State ────────────────────────────────────────────
.dash-empty {
  grid-column: 1 / -1;
  @include flex-col;
  @include flex-center;
  gap: $space-3;
  padding: $space-16;
  text-align: center;

  .material-symbols-outlined {
    font-size: 48px;
    color: var(--color-text-muted);
    opacity: 0.3;
    font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 48;
  }

  &__title {
    font-size: $font-size-lg;
    font-weight: $font-weight-semibold;
    color: var(--color-text-secondary);
  }

  &__text {
    font-size: $font-size-sm;
    color: var(--color-text-muted);
  }
}
</file>

<file path="src/app/pages/workspace/dashboard/dashboard.ts">
import { Component, signal, computed } from '@angular/core';
import { CommonModule } from '@angular/common';
import { Router, ActivatedRoute } from '@angular/router';

interface WidgetConfig {
  id: string;
  label: string;
  icon: string;
  enabled: boolean;
}

@Component({
  selector: 'app-dashboard',
  imports: [CommonModule],
  templateUrl: './dashboard.html',
  styleUrl: './dashboard.scss'
})
export class DashboardComponent {

  readonly username: string;
  showWidgetManager = signal(false);

  constructor(private router: Router, private route: ActivatedRoute) {
    this.username = this.route.snapshot.paramMap.get('username') ?? 'user';
  }

  readonly greeting = signal(this.getGreeting());

  private getGreeting(): string {
    const h = new Date().getHours();
    if (h < 12) return 'Good morning';
    if (h < 18) return 'Good afternoon';
    return 'Good evening';
  }

  readonly today = new Date().toLocaleDateString('en-US', {
    weekday: 'long', month: 'long', day: 'numeric'
  });

  // ── Widget Config ──────────────────────────────────────
  readonly widgetConfigs = signal<WidgetConfig[]>([
    { id: 'tasks', label: 'Daily Actions', icon: 'check_circle', enabled: true },
    { id: 'calendar', label: 'Calendar', icon: 'calendar_month', enabled: true },
    { id: 'goals', label: 'Goals', icon: 'flag', enabled: true },
    { id: 'weekplan', label: 'My Week', icon: 'view_week', enabled: true },
    { id: 'categories', label: 'Categories', icon: 'category', enabled: true },
    { id: 'notifications', label: 'Notifications', icon: 'notifications', enabled: true },
    { id: 'journal', label: 'Journal', icon: 'menu_book', enabled: false },
    { id: 'network', label: 'People', icon: 'people', enabled: false },
    { id: 'following', label: 'Network', icon: 'person_add', enabled: false },
  ]);

  readonly enabledWidgets = computed(() =>
    this.widgetConfigs().filter(w => w.enabled)
  );

  readonly enabledCount = computed(() => this.enabledWidgets().length);

  isWidgetEnabled(id: string): boolean {
    return this.widgetConfigs().find(w => w.id === id)?.enabled ?? false;
  }

  toggleWidget(id: string) {
    this.widgetConfigs.update(configs =>
      configs.map(w => w.id === id ? { ...w, enabled: !w.enabled } : w)
    );
  }

  // ── Data ───────────────────────────────────────────────
  readonly tasks = [
    { id: 1, title: 'Review Annual Financial Report Q4', due: 'OCT 24', dueClass: 'soon', status: 'in-progress', priority: 'high' },
    { id: 2, title: 'Monthly Team Synergy Workshop', due: 'NOV 2', dueClass: 'normal', status: 'open', priority: 'medium' },
    { id: 3, title: 'Finalize Q4 Marketing Budget', due: 'NOV 15', dueClass: 'normal', status: 'open', priority: 'critical' },
  ];

  readonly events = [
    { id: 1, title: 'Product Roadmap Review', time: '10:00 AM', location: 'Conference Room B', color: '#1976d2' },
    { id: 2, title: 'Design System Sync', time: '2:30 PM', location: 'Remote – Zoom', color: '#43a047' },
    { id: 3, title: 'Investor Update Call', time: '4:00 PM', location: 'Remote – Meet', color: '#f57c00' },
  ];

  readonly goals = [
    { id: 1, title: 'Daily Mindful Movement', pct: 68, icon: 'directions_run', deadline: 'DEC 31, 2024' },
    { id: 2, title: 'Portfolio Diversification', pct: 42, icon: 'trending_up', deadline: 'AUG 15, 2024' },
    { id: 3, title: 'Learn Spanish B2', pct: 35, icon: 'school', deadline: 'DEC 31, 2025' },
  ];

  readonly weekplan = {
    title: 'Scaling the Creative Horizon',
    intention: 'Focus on intentional output over reactive checking.',
    status: 'ACTIVE', itemsDone: 2, itemsTotal: 4, pct: 50
  };

  readonly categories = [
    { id: 1, name: 'Work', icon: 'work', color: '#1976d2', count: 'Tasks · Goals · Docs' },
    { id: 2, name: 'Finance', icon: 'payments', color: '#f57c00', count: 'Budget · Goals' },
    { id: 3, name: 'Health', icon: 'self_improvement', color: '#43a047', count: 'Goals · Journal' },
    { id: 4, name: 'Learning', icon: 'school', color: '#e91e63', count: 'Goals · Tasks' },
  ];

  readonly notifications = [
    { id: 1, title: 'Goal Deadline Tomorrow', message: 'Portfolio Diversification is due tomorrow!', type: 'reminder', time: 'Just now', unread: true },
    { id: 2, title: 'Week Plan Starts Tomorrow', message: "Your week 'Q4 Strategy' starts tomorrow.", type: 'info', time: '2h ago', unread: true },
    { id: 3, title: 'New Journal Streak: 7 Days', message: "You've journaled 7 days in a row!", type: 'success', time: '5h ago', unread: false },
  ];

  readonly journalEntries = [
    { id: 1, title: 'Quarterly Review & Future Strategy', mood: 'GREAT', date: 'Oct 12', wordCount: 2400 },
    { id: 2, title: 'Mindful Morning & Technical Debt', mood: 'GOOD', date: 'Oct 11', wordCount: 1120 },
    { id: 3, title: 'Cross-Functional Friction Points', mood: 'OKAY', date: 'Oct 10', wordCount: 850 },
  ];

  readonly contacts = [
    { id: 1, firstname: 'Sarah', lastname: 'Creates', avatarColor: '#e91e63', initials: 'SC', position: 'Product Designer', followStatus: 'FOLLOWING' },
    { id: 2, firstname: 'Felix', lastname: 'Dev', avatarColor: '#43a047', initials: 'FD', position: 'Full-Stack Engineer', followStatus: 'FOLLOWING' },
    { id: 3, firstname: 'Lena', lastname: 'Builds', avatarColor: '#9c27b0', initials: 'LB', position: 'Startup Founder', followStatus: 'NONE' },
  ];

  readonly followingStats = {
    following: 8, followers: 6, pendingRequests: 3
  };

  getMoodIcon(mood: string): string {
    const map: Record<string, string> = {
      GREAT: 'sentiment_very_satisfied', GOOD: 'sentiment_satisfied',
      OKAY: 'sentiment_neutral', BAD: 'sentiment_dissatisfied',
      TERRIBLE: 'sentiment_very_dissatisfied'
    };
    return map[mood] ?? 'sentiment_neutral';
  }

  getMoodColor(mood: string): string {
    const map: Record<string, string> = {
      GREAT: '#43a047', GOOD: '#1976d2', OKAY: '#f9a825',
      BAD: '#f57c00', TERRIBLE: '#d32f2f'
    };
    return map[mood] ?? '#9e9e9e';
  }

  navigateTo(route: string) {
    this.router.navigate([`/workspace/${this.username}/${route}`]);
  }

  onAiClick() { console.log('AI clicked'); }
}
</file>

<file path="src/app/pages/workspace/documents/documents.html">
<!-- Page Header -->
<div class="docs-header">
  <div class="docs-header__text">
    <p class="docs-header__label">Documents</p>
    <p class="docs-header__subtitle">Manage and access all your files in one secure place.</p>
  </div>
  <div class="docs-header__actions">
    <button class="btn-secondary" [class.btn-secondary--active]="activeFilterCount() > 0"
      (click)="showFilter.set(true)">
      <span class="material-symbols-outlined">tune</span>
      Filters
      @if (activeFilterCount() > 0) {
      <span class="filter-active-badge">{{ activeFilterCount() }}</span>
      }
    </button>
    <button class="btn-primary" (click)="openUpload()">
      <span class="material-symbols-outlined">upload</span>
      New Upload
    </button>
  </div>
</div>

<!-- Stats -->
<div class="docs-stats">
  <div class="docs-stat">
    <div class="docs-stat__icon">
      <span class="material-symbols-outlined">storage</span>
    </div>
    <div class="docs-stat__content">
      <span class="docs-stat__label">Total Storage</span>
      <span class="docs-stat__value">{{ totalStorageFormatted() }}</span>
    </div>
  </div>
  <div class="docs-stat">
    <div class="docs-stat__icon">
      <span class="material-symbols-outlined">folder</span>
    </div>
    <div class="docs-stat__content">
      <span class="docs-stat__label">Total Files</span>
      <span class="docs-stat__value">{{ totalFiles() | number }}</span>
    </div>
  </div>
</div>

<!-- Documents Section -->
<div class="docs-container">
  <div class="docs-section-header">
    <h2 class="docs-section-title">Documents</h2>
    <div class="docs-view-toggle">
      <button [class.active]="viewMode() === 'grid'" (click)="viewMode.set('grid')">
        <span class="material-symbols-outlined">grid_view</span>
      </button>
      <button [class.active]="viewMode() === 'list'" (click)="viewMode.set('list')">
        <span class="material-symbols-outlined">view_list</span>
      </button>
    </div>
  </div>

  <!-- Grid View -->
  @if (viewMode() === 'grid') {
  <div class="docs-grid">
    @for (doc of paginatedDocuments(); track doc.id) {
    <div class="doc-card" (click)="openEdit(doc)">
      <div class="doc-card__top">
        <div class="doc-card__file-icon" [style.color]="getFileColor(doc.fileType)">
          <span class="material-symbols-outlined">{{ getFileIcon(doc.fileType) }}</span>
        </div>
        <span [class]="'doc-card__access ' + (doc.accessType === 'PUBLIC' ? 'access--public' : 'access--private')">
          <span class="material-symbols-outlined">
            {{ doc.accessType === 'PUBLIC' ? 'travel_explore' : 'lock' }}
          </span>
          {{ doc.accessType.toLowerCase() }}
        </span>
      </div>
      <h3 class="doc-card__title">{{ doc.title }}</h3>
      <div class="doc-card__footer">
        <span class="doc-card__filetype">{{ doc.fileType.toUpperCase() }}</span>
        <button class="doc-card__download" (click)="downloadDoc(doc, $event)">
          <span class="material-symbols-outlined">download</span>
        </button>
      </div>
    </div>
    }
    <div class="doc-card doc-card--add" (click)="openUpload()">
      <div class="doc-card__add-inner">
        <span class="material-symbols-outlined">add</span>
        <span>Add Document</span>
      </div>
    </div>
  </div>
  }

  <!-- List View -->
  @if (viewMode() === 'list') {
  <div class="docs-list">
    <div class="docs-list__header">
      <span class="docs-list__col docs-list__col--name">Name</span>
      <span class="docs-list__col docs-list__col--type">Type</span>
      <span class="docs-list__col docs-list__col--size">Size</span>
      <span class="docs-list__col docs-list__col--access">Access</span>
      <span class="docs-list__col docs-list__col--date">Uploaded</span>
      <span class="docs-list__col docs-list__col--actions"></span>
    </div>
    @for (doc of paginatedDocuments(); track doc.id) {
    <div class="docs-list__row" (click)="openEdit(doc)">
      <div class="docs-list__col docs-list__col--name">
        <div class="doc-list-name">
          <span class="material-symbols-outlined doc-list-name__icon" [style.color]="getFileColor(doc.fileType)">
            {{ getFileIcon(doc.fileType) }}
          </span>
          <span class="doc-list-name__title">{{ doc.title }}</span>
        </div>
      </div>
      <div class="docs-list__col docs-list__col--type">
        <span class="doc-type-badge" [style.color]="getFileColor(doc.fileType)">
          {{ doc.fileType.toUpperCase() }}
        </span>
      </div>
      <div class="docs-list__col docs-list__col--size">{{ formatSize(doc.fileSizeBytes) }}</div>
      <div class="docs-list__col docs-list__col--access">
        <span [class]="'doc-access-badge ' + (doc.accessType === 'PUBLIC' ? 'access--public' : 'access--private')">
          <span class="material-symbols-outlined">
            {{ doc.accessType === 'PUBLIC' ? 'travel_explore' : 'lock' }}
          </span>
          {{ doc.accessType.toLowerCase() }}
        </span>
      </div>
      <div class="docs-list__col docs-list__col--date">{{ doc.uploadedAt }}</div>
      <div class="docs-list__col docs-list__col--actions">
        <button class="doc-action-btn" (click)="downloadDoc(doc, $event)">
          <span class="material-symbols-outlined">download</span>
        </button>
        <button class="doc-action-btn" (click)="$event.stopPropagation(); openEdit(doc)">
          <span class="material-symbols-outlined">more_vert</span>
        </button>
      </div>
    </div>
    }
  </div>
  }

  <app-pagination [currentPage]="currentPage()" [totalPages]="totalPages()" [totalElements]="totalElements()"
    [pageSize]="pageSize()" (pageChange)="onPageChange($event)" (pageSizeChange)="onPageSizeChange($event)"
    (aiClick)="onAiClick()" />
</div>

<!-- ══ FILTER PANEL ══════════════════════════════════════ -->
@if (showFilter()) {
<app-filter-panel title="Filter Documents" [fields]="documentFilterFields" [initialValues]="activeFilters()"
  (apply)="onFilterApply($event)" (reset)="onFilterReset()" (close)="showFilter.set(false)" />
}

<!-- ══ UPLOAD MODAL ══════════════════════════════════════ -->
@if (showUploadModal()) {
<div class="modal-overlay" (click)="showUploadModal.set(false); showCatDropdown.set(false)">
  <div class="doc-modal" (click)="$event.stopPropagation(); showCatDropdown.set(false)">

    <div class="doc-modal__header">
      <div>
        <h2 class="doc-modal__title">Upload Document</h2>
        <p class="doc-modal__subtitle">Add a file to your document library.</p>
      </div>
      <button class="doc-modal__close" (click)="showUploadModal.set(false)">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>

    @if (!uploadedFile()) {
    <label class="doc-dropzone" for="file-input">
      <span class="material-symbols-outlined doc-dropzone__icon">upload_file</span>
      <span class="doc-dropzone__label">Click to select a file</span>
      <span class="doc-dropzone__hint">PDF, Word, Excel, Images, Video, Audio, Archives and more – max 500 MB</span>
    </label>
    <input id="file-input" type="file" class="doc-modal__file-input"
      accept=".pdf,.docx,.doc,.xlsx,.xls,.pptx,.ppt,.txt,.csv,.png,.jpg,.jpeg,.webp,.gif,.svg,.heic,.mp4,.mov,.avi,.mkv,.webm,.mp3,.wav,.aac,.flac,.m4a,.zip,.rar,.7z,.tar,.json,.xml,.html,.css,.ts,.js"
      (change)="onFileSelect($event)" />
    } @else {
    <div class="doc-file-selected">
      <div class="doc-file-selected__info">
        <span class="material-symbols-outlined doc-file-selected__icon">upload_file</span>
        <div>
          <p class="doc-file-selected__name">{{ uploadedFile()!.name }}</p>
          <p class="doc-file-selected__size">{{ formatSize(uploadedFile()!.size) }}</p>
        </div>
      </div>
      <button class="doc-file-selected__remove" (click)="uploadedFile.set(null); uploadPreviewUrl.set(null)">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>

    @if (uploadPreviewUrl()) {
    <div class="doc-preview">
      @if (uploadedFile()!.type.startsWith('image/')) {
      <img [src]="uploadPreviewUrl()!" alt="Preview" class="doc-preview__img" />
      } @else if (uploadedFile()!.type === 'application/pdf') {
      <iframe [src]="uploadPreviewUrl()!" class="doc-preview__pdf" title="PDF Preview"></iframe>
      } @else if (uploadedFile()!.type.startsWith('video/')) {
      <video class="doc-preview__video" controls>
        <source [src]="uploadPreviewUrl()!" />
      </video>
      } @else if (uploadedFile()!.type.startsWith('audio/')) {
      <audio class="doc-preview__audio" controls>
        <source [src]="uploadPreviewUrl()!" />
      </audio>
      }
    </div>
    }
    }

    <div class="form-group">
      <label>Title</label>
      <input type="text" placeholder="Document title..." [(ngModel)]="uploadForm().title" />
    </div>

    <div class="form-group">
      <label>Description <span class="form-group__optional">optional</span></label>
      <textarea rows="2" placeholder="Brief description of this document..."
        [(ngModel)]="uploadForm().description"></textarea>
    </div>

    <!-- Categories Dropdown -->
    <div class="form-group" (click)="$event.stopPropagation()">
      <label>Categories</label>
      <div class="modal-cat-dropdown">
        <button class="modal-cat-dropdown__trigger"
          [class.modal-cat-dropdown__trigger--active]="uploadForm().categoryIds.length > 0"
          [class.modal-cat-dropdown__trigger--open]="showCatDropdown()" (click)="toggleCatDropdown($event)">
          <div class="modal-cat-dropdown__trigger-left">
            @if (uploadForm().categoryIds.length > 0) {
            <div class="modal-cat-dropdown__dots">
              @for (color of getSelectedCatColors(uploadForm().categoryIds); track color) {
              <span class="modal-cat-dropdown__dot" [style.background]="color"></span>
              }
            </div>
            }
            <span class="modal-cat-dropdown__label">
              {{ getCatDropdownLabel(uploadForm().categoryIds) }}
            </span>
          </div>
          <span class="material-symbols-outlined modal-cat-dropdown__arrow">
            {{ showCatDropdown() ? 'expand_less' : 'expand_more' }}
          </span>
        </button>
        @if (showCatDropdown()) {
        <div class="modal-cat-dropdown__menu">
          @for (cat of availableCategories(); track cat.id) {
          <button class="modal-cat-dropdown__item"
            [class.modal-cat-dropdown__item--selected]="uploadForm().categoryIds.includes(cat.id)"
            (click)="toggleUploadCategory(cat.id)">
            <div class="modal-cat-dropdown__item-check">
              @if (uploadForm().categoryIds.includes(cat.id)) {
              <span class="material-symbols-outlined">check</span>
              }
            </div>
            <span class="material-symbols-outlined modal-cat-dropdown__item-icon" [style.color]="cat.color">{{ cat.icon
              }}</span>
            <span class="modal-cat-dropdown__item-label">{{ cat.name }}</span>
          </button>
          }
          @if (uploadForm().categoryIds.length > 0) {
          <div class="modal-cat-dropdown__footer">
            <button class="modal-cat-dropdown__clear"
              (click)="uploadForm.update(f => ({ ...f, categoryIds: [] })); $event.stopPropagation()">
              <span class="material-symbols-outlined">close</span>Clear
            </button>
          </div>
          }
        </div>
        }
      </div>
    </div>

    <div class="form-group">
      <label>Access</label>
      <div class="modal-access-toggle">
        <button [class]="'modal-access-btn ' + (uploadForm().accessType === 'PRIVATE' ? 'active' : '')"
          (click)="uploadForm.update(f => ({ ...f, accessType: 'PRIVATE' }))">
          <span class="material-symbols-outlined">lock</span>Private
        </button>
        <button [class]="'modal-access-btn ' + (uploadForm().accessType === 'PUBLIC' ? 'active' : '')"
          (click)="uploadForm.update(f => ({ ...f, accessType: 'PUBLIC' }))">
          <span class="material-symbols-outlined">travel_explore</span>Public
        </button>
      </div>
    </div>

    <div class="doc-modal__footer">
      <button class="btn-secondary" (click)="showUploadModal.set(false)">Cancel</button>
      <button class="btn-primary" [disabled]="!uploadedFile()" (click)="submitUpload()">
        <span class="material-symbols-outlined">upload</span>Upload
      </button>
    </div>
  </div>
</div>
}

<!-- ══ EDIT / DETAILS MODAL ══════════════════════════════ -->
@if (showEditModal() && selectedDocument()) {
<div class="modal-overlay" (click)="showEditModal.set(false); showEditCatDropdown.set(false)">
  <div class="doc-modal" (click)="$event.stopPropagation(); showEditCatDropdown.set(false)">

    <div class="doc-modal__header">
      <div>
        <h2 class="doc-modal__title">Document Details</h2>
        <p class="doc-modal__subtitle">View and edit document metadata.</p>
      </div>
      <div class="doc-modal__header-actions">
        <button class="doc-modal__action-btn doc-modal__action-btn--download"
          (click)="downloadDoc(selectedDocument()!, $event)" title="Download">
          <span class="material-symbols-outlined">download</span>
        </button>
        <button class="doc-modal__action-btn doc-modal__action-btn--delete"
          (click)="openDeleteConfirm(selectedDocument()!)" title="Delete">
          <span class="material-symbols-outlined">delete</span>
        </button>
        <button class="doc-modal__close" (click)="showEditModal.set(false)">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
    </div>

    <div class="doc-modal__file-info">
      <div class="doc-modal__file-icon" [style.color]="getFileColor(selectedDocument()!.fileType)">
        <span class="material-symbols-outlined">{{ getFileIcon(selectedDocument()!.fileType) }}</span>
      </div>
      <div>
        <p class="doc-modal__file-type">{{ getFileTypeName(selectedDocument()!.fileType) }}</p>
        <p class="doc-modal__file-meta">
          {{ formatSize(selectedDocument()!.fileSizeBytes) }} · Uploaded {{ selectedDocument()!.uploadedAt }}
        </p>
      </div>
    </div>

    @if (canPreview(selectedDocument()!.fileType) && selectedDocument()!.previewUrl) {
    <div class="doc-preview">
      @if (isImage(selectedDocument()!.fileType)) {
      <img [src]="selectedDocument()!.previewUrl!" alt="Preview" class="doc-preview__img" />
      } @else if (selectedDocument()!.fileType === 'pdf') {
      <iframe [src]="selectedDocument()!.previewUrl!" class="doc-preview__pdf" title="PDF Preview"></iframe>
      } @else if (isVideo(selectedDocument()!.fileType)) {
      <video class="doc-preview__video" controls>
        <source [src]="selectedDocument()!.previewUrl!" />
      </video>
      } @else if (isAudio(selectedDocument()!.fileType)) {
      <audio class="doc-preview__audio" controls>
        <source [src]="selectedDocument()!.previewUrl!" />
      </audio>
      }
    </div>
    } @else if (canPreview(selectedDocument()!.fileType) && !selectedDocument()!.previewUrl) {
    <div class="doc-preview-placeholder">
      <span class="material-symbols-outlined" [style.color]="getFileColor(selectedDocument()!.fileType)">
        {{ getFileIcon(selectedDocument()!.fileType) }}
      </span>
      <p>Preview available after download</p>
      <button class="btn-secondary btn-sm" (click)="downloadDoc(selectedDocument()!, $event)">
        <span class="material-symbols-outlined">download</span>Download to preview
      </button>
    </div>
    } @else {
    <div class="doc-preview-placeholder">
      <span class="material-symbols-outlined" [style.color]="getFileColor(selectedDocument()!.fileType)">
        {{ getFileIcon(selectedDocument()!.fileType) }}
      </span>
      <p>Preview not available for {{ selectedDocument()!.fileType.toUpperCase() }} files</p>
    </div>
    }

    <div class="form-group">
      <label>Title</label>
      <input type="text" placeholder="Document title..." [(ngModel)]="editForm().title" />
    </div>

    <div class="form-group">
      <label>Description <span class="form-group__optional">optional</span></label>
      <textarea rows="2" placeholder="Brief description..." [(ngModel)]="editForm().description"></textarea>
    </div>

    <!-- Categories Dropdown -->
    <div class="form-group" (click)="$event.stopPropagation()">
      <label>Categories</label>
      <div class="modal-cat-dropdown">
        <button class="modal-cat-dropdown__trigger"
          [class.modal-cat-dropdown__trigger--active]="editForm().categoryIds.length > 0"
          [class.modal-cat-dropdown__trigger--open]="showEditCatDropdown()" (click)="toggleEditCatDropdown($event)">
          <div class="modal-cat-dropdown__trigger-left">
            @if (editForm().categoryIds.length > 0) {
            <div class="modal-cat-dropdown__dots">
              @for (color of getSelectedCatColors(editForm().categoryIds); track color) {
              <span class="modal-cat-dropdown__dot" [style.background]="color"></span>
              }
            </div>
            }
            <span class="modal-cat-dropdown__label">
              {{ getCatDropdownLabel(editForm().categoryIds) }}
            </span>
          </div>
          <span class="material-symbols-outlined modal-cat-dropdown__arrow">
            {{ showEditCatDropdown() ? 'expand_less' : 'expand_more' }}
          </span>
        </button>
        @if (showEditCatDropdown()) {
        <div class="modal-cat-dropdown__menu">
          @for (cat of availableCategories(); track cat.id) {
          <button class="modal-cat-dropdown__item"
            [class.modal-cat-dropdown__item--selected]="editForm().categoryIds.includes(cat.id)"
            (click)="toggleEditCategory(cat.id)">
            <div class="modal-cat-dropdown__item-check">
              @if (editForm().categoryIds.includes(cat.id)) {
              <span class="material-symbols-outlined">check</span>
              }
            </div>
            <span class="material-symbols-outlined modal-cat-dropdown__item-icon" [style.color]="cat.color">{{ cat.icon
              }}</span>
            <span class="modal-cat-dropdown__item-label">{{ cat.name }}</span>
          </button>
          }
          @if (editForm().categoryIds.length > 0) {
          <div class="modal-cat-dropdown__footer">
            <button class="modal-cat-dropdown__clear"
              (click)="editForm.update(f => ({ ...f, categoryIds: [] })); $event.stopPropagation()">
              <span class="material-symbols-outlined">close</span>Clear
            </button>
          </div>
          }
        </div>
        }
      </div>
    </div>

    <div class="form-group">
      <label>Access</label>
      <div class="modal-access-toggle">
        <button [class]="'modal-access-btn ' + (editForm().accessType === 'PRIVATE' ? 'active' : '')"
          (click)="editForm.update(f => ({ ...f, accessType: 'PRIVATE' }))">
          <span class="material-symbols-outlined">lock</span>Private
        </button>
        <button [class]="'modal-access-btn ' + (editForm().accessType === 'PUBLIC' ? 'active' : '')"
          (click)="editForm.update(f => ({ ...f, accessType: 'PUBLIC' }))">
          <span class="material-symbols-outlined">travel_explore</span>Public
        </button>
      </div>
    </div>

    <div class="doc-modal__footer">
      <button class="btn-secondary" (click)="showEditModal.set(false)">Cancel</button>
      <button class="btn-primary" (click)="submitEdit()">Save Changes</button>
    </div>
  </div>
</div>
}

<!-- ══ DELETE CONFIRM ════════════════════════════════════ -->
@if (showDeleteConfirm() && selectedDocument()) {
<div class="modal-overlay" (click)="showDeleteConfirm.set(false)">
  <div class="confirm-dialog" (click)="$event.stopPropagation()">
    <div class="confirm-dialog__icon confirm-dialog__icon--danger">
      <span class="material-symbols-outlined">delete</span>
    </div>
    <h3 class="confirm-dialog__title">Delete Document</h3>
    <p class="confirm-dialog__text">
      Are you sure you want to delete <strong>"{{ selectedDocument()!.title }}"</strong>?
      The file will be permanently removed from storage.
    </p>
    <div class="confirm-dialog__actions">
      <button class="btn-secondary" (click)="showDeleteConfirm.set(false)">Cancel</button>
      <button class="btn-danger" (click)="confirmDelete()">Delete Document</button>
    </div>
  </div>
</div>
}
</file>

