<file path="src/app/pages/workspace/categories/categories.html">
<!-- Page Header -->
<div class="categories-header">
  <div class="categories-header__text">
    <p class="categories-header__label">Categories</p>
    <p class="categories-header__subtitle">
      Group your tasks, goals and documents into meaningful categories.
    </p>
  </div>
  <div class="categories-header__actions">
    <button
      class="btn-secondary"
      [class.btn-secondary--active]="activeFilterCount() > 0"
      (click)="showFilter.set(true)"
    >
      <span class="material-symbols-outlined">tune</span>
      Filters
      @if (activeFilterCount() > 0) {
        <span class="filter-active-badge">{{ activeFilterCount() }}</span>
      }
    </button>
    <button class="btn-primary" (click)="openCreate()">
      <span class="material-symbols-outlined">add</span>
      Create Category
    </button>
  </div>
</div>

<!-- Grid -->
<div class="categories-container">
  <div class="categories-grid">
    @for (category of paginatedCategories(); track category.id) {
      <div class="category-card" (click)="openEdit(category)">
        <div class="category-card__bar" [style.background]="category.color"></div>
        <div class="category-card__body">
          <div class="category-card__top">
            <div class="category-card__icon" [style.background]="category.color + '18'">
              <span class="material-symbols-outlined" [style.color]="category.color">
                {{ category.icon }}
              </span>
            </div>
            <span
              [class]="
                'category-card__access ' +
                (category.accessType === 'PUBLIC' ? 'access--public' : 'access--private')
              "
            >
              <span class="material-symbols-outlined">
                {{ category.accessType === 'PUBLIC' ? 'travel_explore' : 'lock' }}
              </span>
              {{ category.accessType.toLowerCase() }}
            </span>
          </div>
          <h3 class="category-card__name">{{ category.name }}</h3>
          <p class="category-card__desc">{{ category.description }}</p>
          <div class="category-card__footer">
            <span class="category-card__date">
              <span class="material-symbols-outlined">calendar_today</span>
              Created {{ category.createdAt }}
            </span>
            <button class="category-card__arrow" (click)="openEdit(category, $event)">
              <span class="material-symbols-outlined">arrow_forward</span>
            </button>
          </div>
        </div>
      </div>
    }

    <div class="category-card category-card--add" (click)="openCreate()">
      <div class="category-card__add-inner">
        <div class="category-card__add-icon">
          <span class="material-symbols-outlined">add</span>
        </div>
        <span class="category-card__add-label">Add New</span>
        <span class="category-card__add-sub">Define a category</span>
      </div>
    </div>
  </div>

  <app-pagination
    [currentPage]="currentPage()"
    [totalPages]="totalPages()"
    [totalElements]="totalElements()"
    [pageSize]="pageSize()"
    (pageChange)="onPageChange($event)"
    (pageSizeChange)="onPageSizeChange($event)"
    (aiClick)="onAiClick()"
  />
</div>

<!-- ══ FILTER PANEL ══════════════════════════════════════ -->
@if (showFilter()) {
  <app-filter-panel
    title="Filter Categories"
    [fields]="categoryFilterFields"
    [initialValues]="activeFilters()"
    (apply)="onFilterApply($event)"
    (reset)="onFilterReset()"
    (close)="showFilter.set(false)"
  />
}

<!-- ══ CREATE MODAL ══════════════════════════════════════ -->
@if (showCreateModal()) {
  <div class="modal-overlay" (click)="showCreateModal.set(false)">
    <div class="cat-modal" (click)="$event.stopPropagation()">
      <div class="cat-modal__header">
        <div>
          <h2 class="cat-modal__title">New Category</h2>
          <p class="cat-modal__subtitle">Organize your content into a meaningful group.</p>
        </div>
        <button class="cat-modal__close" (click)="showCreateModal.set(false)">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>

      <!-- Preview -->
      <div class="cat-modal__preview">
        <div class="cat-preview" [style.border-color]="createForm().color">
          <div class="cat-preview__icon" [style.background]="createForm().color + '20'">
            <span class="material-symbols-outlined" [style.color]="createForm().color">
              {{ createForm().icon }}
            </span>
          </div>
          <div class="cat-preview__info">
            <span class="cat-preview__name">{{ createForm().name || 'Category name' }}</span>
            <span class="cat-preview__desc">{{
              createForm().description || 'Description...'
            }}</span>
          </div>
        </div>
      </div>

      <!-- Name + Description -->
      <div class="form-group">
        <label>Name</label>
        <input
          type="text"
          placeholder="e.g. Work, Health, Finance..."
          [(ngModel)]="createForm().name"
        />
      </div>
      <div class="form-group">
        <label>Description</label>
