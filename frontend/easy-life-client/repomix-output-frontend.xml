          </span>
        </div>
        <p class="nprofile-goal-card__desc">{{ goal.description }}</p>
        <div class="nprofile-goal-card__progress-row">
          <div class="progress-bar progress-bar-sm" style="flex:1">
            <div class="progress-fill" [style.width.%]="goal.pct"></div>
          </div>
          <span class="nprofile-goal-card__pct">{{ goal.pct }}%</span>
        </div>
        <span class="nprofile-goal-card__deadline">
          <span class="material-symbols-outlined">calendar_today</span>
          {{ goal.deadline }}
        </span>
      </div>
    </div>
    }
  </div>
  }

  <!-- Categories Tab -->
  @if (activeTab() === 'categories') {
  <div class="nprofile-categories">
    @for (cat of categories; track cat.id) {
    <div class="nprofile-cat-card">
      <div class="nprofile-cat-card__icon" [style.background]="cat.color + '18'">
        <span class="material-symbols-outlined" [style.color]="cat.color">{{ cat.icon }}</span>
      </div>
      <div class="nprofile-cat-card__info">
        <h3 class="nprofile-cat-card__name">{{ cat.name }}</h3>
        <p class="nprofile-cat-card__desc">{{ cat.description }}</p>
      </div>
      <div class="nprofile-cat-card__bar" [style.background]="cat.color"></div>
    </div>
