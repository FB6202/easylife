  <!-- Contacts Tab -->
  @if (activeTab() === 'contacts') {
  <div class="nprofile-contacts">
    @for (contact of contacts; track contact.id) {
    <div class="nprofile-contact-card">
      <div class="nprofile-contact-card__avatar" [style.background]="contact.avatarColor">
        {{ contact.initials }}
