            >
              @if (createForm().color === color) {
                <span class="material-symbols-outlined">check</span>
              }
            </button>
          }
        </div>
      </div>

      <!-- Icon Picker -->
      <div class="form-group">
        <label>Icon</label>
        <div class="icon-search">
          <span class="material-symbols-outlined">search</span>
          <input
            type="text"
            placeholder="Search icons..."
            [value]="iconSearchQuery()"
            (input)="iconSearchQuery.set($any($event.target).value)"
          />
        </div>
        <div class="icon-picker-grid">
          @for (icon of filteredIcons(); track icon) {
            <button
              [class]="'icon-btn ' + (createForm().icon === icon ? 'icon-btn--active' : '')"
              [style.color]="createForm().icon === icon ? createForm().color : ''"
              [style.border-color]="createForm().icon === icon ? createForm().color : ''"
              (click)="createForm.update((f) => ({ ...f, icon: icon }))"
              [title]="icon"
            >
              <span class="material-symbols-outlined">{{ icon }}</span>
            </button>
          }
          @if (filteredIcons().length === 0) {
            <p class="icon-picker-empty">No icons found</p>
          }
        </div>
      </div>

      <!-- Access -->
      <div class="form-group">
        <label>Access</label>
        <div class="modal-access-toggle">
          <button
            [class]="'modal-access-btn ' + (createForm().accessType === 'PRIVATE' ? 'active' : '')"
            (click)="createForm.update((f) => ({ ...f, accessType: 'PRIVATE' }))"
          >
            <span class="material-symbols-outlined">lock</span>
            Private
          </button>
          <button
            [class]="'modal-access-btn ' + (createForm().accessType === 'PUBLIC' ? 'active' : '')"
            (click)="createForm.update((f) => ({ ...f, accessType: 'PUBLIC' }))"
          >
            <span class="material-symbols-outlined">travel_explore</span>
            Public
          </button>
        </div>
      </div>

      <div class="cat-modal__footer">
        <button class="btn-secondary" (click)="showCreateModal.set(false)">Cancel</button>
        <button class="btn-primary" (click)="submitCreate()">Create Category</button>
      </div>
    </div>
  </div>
}

