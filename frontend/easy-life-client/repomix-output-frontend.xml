<div class="profile-page">
  <!-- Page Header -->
  <div class="profile-header">
    <div>
      <p class="profile-header__label">Account</p>
      <h1 class="profile-header__title">Profile & Settings</h1>
      <p class="profile-header__subtitle">Manage your personal information and preferences.</p>
    </div>
    <div class="profile-header__nav">
      <button class="profile-nav-btn" (click)="scrollToSection('section-profile')">
        <span class="material-symbols-outlined">person</span>
        Profile
      </button>
      <button class="profile-nav-btn" (click)="scrollToSection('section-address')">
        <span class="material-symbols-outlined">location_on</span>
        Address
      </button>
      <button class="profile-nav-btn" (click)="scrollToSection('section-preferences')">
        <span class="material-symbols-outlined">tune</span>
        Preferences
      </button>
      <button class="profile-nav-btn" (click)="scrollToSection('section-security')">
        <span class="material-symbols-outlined">security</span>
        Security
      </button>
      <button class="profile-nav-btn" (click)="scrollToSection('section-billing')">
        <span class="material-symbols-outlined">card_membership</span>
        Billing
      </button>
    </div>
  </div>

  <!-- ══ PROFILE ══════════════════════════════════════════ -->
  <div class="profile-section" id="section-profile">
    <div class="profile-section__header">
      <div class="profile-section__header-left">
        <span class="material-symbols-outlined profile-section__icon">person</span>
        <div>
          <h2 class="profile-section__title">Profile</h2>
          <p class="profile-section__subtitle">Your public and personal information.</p>
        </div>
      </div>
    </div>

    <!-- Avatar -->
    <div class="profile-avatar-row">
      <div class="profile-avatar">
        <span class="profile-avatar__initials">{{ getInitials() }}</span>
        <button class="profile-avatar__edit">
          <span class="material-symbols-outlined">photo_camera</span>
        </button>
      </div>
      <div class="profile-avatar__info">
        <h3 class="profile-avatar__name">{{ firstname() }} {{ lastname() }}</h3>
        <p class="profile-avatar__email">{{ email() }}</p>
        <p class="profile-avatar__hint">Click the avatar to upload a photo</p>
      </div>
    </div>

    <!-- Name -->
    <div class="profile-form-grid">
      <div class="form-group">
        <label>First Name</label>
        <input
          type="text"
          [value]="firstname()"
          (input)="firstname.set($any($event.target).value); markChanged()"
        />
      </div>
      <div class="form-group">
        <label>Last Name</label>
        <input
          type="text"
          [value]="lastname()"
          (input)="lastname.set($any($event.target).value); markChanged()"
        />
      </div>
    </div>

    <!-- Email -->
    <div class="form-group">
      <label>
        Email
        <span class="form-group__hint">managed by Keycloak</span>
      </label>
      <input type="email" [value]="email()" disabled class="input--disabled" />
    </div>

    <!-- Bio -->
    <div class="form-group">
      <label>
        Bio
        <span class="form-group__optional">optional</span>
      </label>
      <textarea
        rows="4"
        [attr.maxlength]="bioMaxLength"
        [value]="bio()"
        (input)="bio.set($any($event.target).value); markChanged()"
        placeholder="Tell others a bit about yourself..."
      ></textarea>
      <span class="form-group__counter">{{ bio().length }}/{{ bioMaxLength }}</span>
    </div>
  </div>

  <!-- ══ ADDRESS ══════════════════════════════════════════ -->
  <div class="profile-section" id="section-address">
    <div class="profile-section__header">
      <div class="profile-section__header-left">
        <span class="material-symbols-outlined profile-section__icon">location_on</span>
        <div>
          <h2 class="profile-section__title">Address</h2>
          <p class="profile-section__subtitle">Your billing and contact address.</p>
        </div>
      </div>
    </div>

    <div class="profile-form-grid">
      <div class="form-group">
        <label>Country</label>
        <input
          type="text"
          [value]="country()"
          (input)="country.set($any($event.target).value); markChanged()"
        />
      </div>
      <div class="form-group">
        <label>City</label>
        <input
          type="text"
          [value]="city()"
          (input)="city.set($any($event.target).value); markChanged()"
        />
      </div>
      <div class="form-group">
        <label>Street</label>
        <input
          type="text"
          [value]="street()"
          (input)="street.set($any($event.target).value); markChanged()"
        />
      </div>
      <div class="form-group">
        <label>Number</label>
        <input
          type="text"
          [value]="number()"
          (input)="number.set($any($event.target).value); markChanged()"
        />
      </div>
      <div class="form-group">
        <label>ZIP Code</label>
        <input
          type="text"
          [value]="zipCode()"
          (input)="zipCode.set($any($event.target).value); markChanged()"
        />
      </div>
      <div class="form-group">
        <label>Additional Info <span class="form-group__optional">optional</span></label>
        <input
          type="text"
          placeholder="Apartment, suite, etc."
          [value]="additionalInfo()"
          (input)="additionalInfo.set($any($event.target).value); markChanged()"
        />
      </div>
    </div>
  </div>

  <!-- ══ PREFERENCES ══════════════════════════════════════ -->
  <div class="profile-section" id="section-preferences">
    <div class="profile-section__header">
      <div class="profile-section__header-left">
        <span class="material-symbols-outlined profile-section__icon">tune</span>
        <div>
          <h2 class="profile-section__title">Preferences</h2>
          <p class="profile-section__subtitle">Appearance, language and notification settings.</p>
        </div>
      </div>
    </div>

    <!-- Theme -->
    <div class="pref-row">
      <div class="pref-row__info">
        <span class="material-symbols-outlined">computer</span>
        <div>
          <p class="pref-row__label">Web Theme</p>
          <p class="pref-row__desc">Choose your preferred color scheme for the web app.</p>
        </div>
      </div>
      <div class="pref-theme-toggle">
        @for (theme of themes; track theme.value) {
          <button
            [class]="
              'pref-theme-btn ' + (webColorTheme() === theme.value ? 'pref-theme-btn--active' : '')
            "
            (click)="webColorTheme.set(theme.value); markChanged()"
          >
            <span class="material-symbols-outlined">{{ theme.icon }}</span>
            {{ theme.label }}
          </button>
        }
      </div>
    </div>

    <div class="pref-row">
      <div class="pref-row__info">
        <span class="material-symbols-outlined">phone_iphone</span>
        <div>
          <p class="pref-row__label">Mobile Theme</p>
          <p class="pref-row__desc">Choose your preferred color scheme for the mobile app.</p>
        </div>
      </div>
      <div class="pref-theme-toggle">
        @for (theme of themes; track theme.value) {
          <button
            [class]="
              'pref-theme-btn ' +
              (mobileColorTheme() === theme.value ? 'pref-theme-btn--active' : '')
            "
            (click)="mobileColorTheme.set(theme.value); markChanged()"
          >
            <span class="material-symbols-outlined">{{ theme.icon }}</span>
            {{ theme.label }}
          </button>
        }
      </div>
    </div>

    <!-- Language -->
    <div class="pref-row">
      <div class="pref-row__info">
        <span class="material-symbols-outlined">translate</span>
        <div>
          <p class="pref-row__label">Language</p>
          <p class="pref-row__desc">Choose your preferred display language.</p>
        </div>
      </div>
      <div class="pref-lang-toggle">
        @for (lang of languages; track lang.value) {
          <button
            [class]="'pref-lang-btn ' + (language() === lang.value ? 'pref-lang-btn--active' : '')"
            (click)="language.set(lang.value); markChanged()"
          >
            <span>{{ lang.flag }}</span>
            {{ lang.label }}
          </button>
        }
      </div>
    </div>

    <!-- Notifications -->
    <div class="pref-row">
      <div class="pref-row__info">
        <span class="material-symbols-outlined">email</span>
        <div>
          <p class="pref-row__label">Email Notifications</p>
          <p class="pref-row__desc">Receive updates and reminders via email.</p>
        </div>
      </div>
      <label class="pref-toggle">
        <input
          type="checkbox"
          [checked]="emailNotifications()"
          (change)="emailNotifications.update((v) => !v); markChanged()"
        />
        <span class="pref-toggle__slider"></span>
      </label>
    </div>

    <div class="pref-row">
      <div class="pref-row__info">
        <span class="material-symbols-outlined">phone_iphone</span>
        <div>
          <p class="pref-row__label">Push Notifications</p>
          <p class="pref-row__desc">Get push alerts on your mobile device.</p>
        </div>
      </div>
      <label class="pref-toggle">
        <input
          type="checkbox"
          [checked]="pushNotifications()"
          (change)="pushNotifications.update((v) => !v); markChanged()"
        />
        <span class="pref-toggle__slider"></span>
      </label>
    </div>
  </div>

  <!-- ══ SECURITY & PRIVACY ════════════════════════════════ -->
  <div class="profile-section" id="section-security">
    <div class="profile-section__header">
      <div class="profile-section__header-left">
        <span class="material-symbols-outlined profile-section__icon">security</span>
        <div>
          <h2 class="profile-section__title">Security & Privacy</h2>
          <p class="profile-section__subtitle">Manage your password, 2FA and account security.</p>
        </div>
      </div>
    </div>

    <!-- Change Password -->
    <div class="profile-subsection">
      <h3 class="profile-subsection__title">Change Password</h3>
      <div class="profile-form-grid">
        <div class="form-group">
          <label>Current Password</label>
          <input
            type="password"
            placeholder="Enter current password"
            [value]="currentPassword()"
            (input)="currentPassword.set($any($event.target).value)"
          />
        </div>
        <div class="form-group">
          <label>New Password</label>
          <input
            type="password"
            placeholder="Enter new password"
            [value]="newPassword()"
            (input)="newPassword.set($any($event.target).value)"
          />
        </div>
        <div class="form-group">
          <label>Confirm New Password</label>
          <input
            type="password"
            placeholder="Repeat new password"
            [value]="confirmPassword()"
            (input)="confirmPassword.set($any($event.target).value)"
          />
        </div>
      </div>
      <div class="profile-subsection__action">
        <button class="btn-secondary">
          <span class="material-symbols-outlined">lock_reset</span>
          Update Password
        </button>
      </div>
    </div>

    <!-- 2FA -->
    <div class="profile-subsection">
      <h3 class="profile-subsection__title">Two-Factor Authentication</h3>
      <div class="security-row">
        <div class="security-row__info">
          <span
            class="material-symbols-outlined security-row__icon"
            [style.color]="twoFactorEnabled() ? '#43a047' : '#9e9e9e'"
          >
            {{ twoFactorEnabled() ? 'verified_user' : 'shield' }}
          </span>
          <div>
            <p class="security-row__label">
              2FA is currently
              <strong [style.color]="twoFactorEnabled() ? '#43a047' : '#d32f2f'">
                {{ twoFactorEnabled() ? 'enabled' : 'disabled' }}
              </strong>
            </p>
            <p class="security-row__desc">Add an extra layer of security via authenticator app.</p>
          </div>
        </div>
        <button
          [class]="twoFactorEnabled() ? 'btn-secondary' : 'btn-primary'"
          (click)="twoFactorEnabled.update((v) => !v)"
        >
          <span class="material-symbols-outlined">
            {{ twoFactorEnabled() ? 'toggle_off' : 'toggle_on' }}
          </span>
          {{ twoFactorEnabled() ? 'Disable 2FA' : 'Enable 2FA' }}
        </button>
      </div>
    </div>

    <!-- Session Timeout -->
    <div class="profile-subsection">
      <h3 class="profile-subsection__title">Session Timeout</h3>
      <div class="profile-form-grid profile-form-grid--single">
        <div class="form-group">
          <label>Auto Logout After</label>
          <select
            [value]="sessionTimeout()"
            (change)="sessionTimeout.set($any($event.target).value)"
          >
            @for (opt of sessionTimeoutOptions; track opt.value) {
              <option [value]="opt.value">{{ opt.label }}</option>
            }
          </select>
        </div>
      </div>
    </div>

    <!-- Danger Zone -->
    <div class="profile-subsection profile-subsection--danger">
      <h3 class="profile-subsection__title profile-subsection__title--danger">Danger Zone</h3>
      <div class="security-row">
        <div class="security-row__info">
          <span class="material-symbols-outlined security-row__icon" style="color: #d32f2f">
            delete_forever
          </span>
          <div>
            <p class="security-row__label">Delete Account</p>
            <p class="security-row__desc">
              Permanently delete your account and all data. This cannot be undone.
            </p>
          </div>
        </div>
        <button class="btn-danger" (click)="showDeleteConfirm.set(true)">
          <span class="material-symbols-outlined">delete_forever</span>
          Delete Account
        </button>
      </div>
    </div>
  </div>

  <!-- ══ SUBSCRIPTION & BILLING ════════════════════════════ -->
  <div class="profile-section" id="section-billing">
    <div class="profile-section__header">
      <div class="profile-section__header-left">
        <span class="material-symbols-outlined profile-section__icon">card_membership</span>
        <div>
          <h2 class="profile-section__title">Subscription & Billing</h2>
          <p class="profile-section__subtitle">Manage your plan and billing information.</p>
        </div>
      </div>
    </div>

    <!-- Current Plan Badge -->
    <div class="profile-subsection">
      <h3 class="profile-subsection__title">Current Plan</h3>
      <div class="billing-current">
        <span class="billing-current__badge">{{ currentPlan() }}</span>
        <div>
          <p class="billing-current__label">You are on the Free plan</p>
          <p class="billing-current__desc">
            Upgrade to unlock unlimited tasks, goals, AI and more.
          </p>
        </div>
      </div>
    </div>

    <!-- Plan Cards -->
    <div class="profile-subsection">
      <h3 class="profile-subsection__title">Available Plans</h3>
      <div class="billing-plans">
        @for (plan of plans; track plan.id) {
          <div
            class="billing-card"
            [class.billing-card--active]="currentPlan() === plan.id"
            [class.billing-card--popular]="plan.popular"
            [style.--plan-color]="plan.color"
          >
            @if (plan.popular) {
              <div class="billing-card__badge">Most Popular</div>
            }
            <div class="billing-card__header">
              <h4 class="billing-card__name" [style.color]="plan.color">{{ plan.label }}</h4>
              <div class="billing-card__price">
                <span class="billing-card__amount">{{ plan.price }}</span>
                <span class="billing-card__period">{{ plan.period }}</span>
              </div>
            </div>
            <ul class="billing-card__features">
              @for (feature of plan.features; track feature) {
                <li>
                  <span class="material-symbols-outlined">check</span>
                  {{ feature }}
                </li>
              }
            </ul>
            @if (currentPlan() === plan.id) {
              <button class="billing-card__btn billing-card__btn--current" disabled>
                Current Plan
              </button>
            } @else {
              <button class="billing-card__btn" [style.background]="plan.color">
                {{ plan.id === 'FREE' ? 'Downgrade' : 'Upgrade to ' + plan.label }}
              </button>
            }
          </div>
        }
      </div>
    </div>

    <!-- Payment Method -->
    <div class="profile-subsection">
      <h3 class="profile-subsection__title">Payment Method</h3>
      <div class="billing-empty">
        <span class="material-symbols-outlined">credit_card_off</span>
        <p>No payment method on file.</p>
        <p class="billing-empty__sub">Add a payment method to upgrade your plan.</p>
        <button class="btn-secondary">
          <span class="material-symbols-outlined">add_card</span>
          Add Payment Method
        </button>
      </div>
    </div>
  </div>

  <!-- ══ STICKY SAVE BAR ═══════════════════════════════════ -->
  @if (hasChanges()) {
    <div class="profile-save-bar">
      <p class="profile-save-bar__text">
        <span class="material-symbols-outlined">info</span>
        You have unsaved changes
      </p>
      <div class="profile-save-bar__actions">
        <button class="btn-secondary" (click)="onDiscard()">Discard</button>
        <button class="btn-primary" (click)="onSave()">
          <span class="material-symbols-outlined">save</span>
          Save Changes
        </button>
      </div>
    </div>
  }
</div>

<!-- ══ DELETE CONFIRM ════════════════════════════════════ -->
@if (showDeleteConfirm()) {
  <div class="modal-overlay" (click)="showDeleteConfirm.set(false)">
    <div class="confirm-dialog" (click)="$event.stopPropagation()">
      <div class="confirm-dialog__icon confirm-dialog__icon--danger">
        <span class="material-symbols-outlined">delete_forever</span>
      </div>
      <h3 class="confirm-dialog__title">Delete Account</h3>
      <p class="confirm-dialog__text">
        This will permanently delete your account, all tasks, goals, documents and settings.
        <strong>This cannot be undone.</strong>
      </p>
      <div class="confirm-dialog__actions">
        <button class="btn-secondary" (click)="showDeleteConfirm.set(false)">Cancel</button>
        <button class="btn-danger">Yes, Delete My Account</button>
      </div>
    </div>
  </div>
}
</file>

<file path="src/app/pages/workspace/profile/profile.scss">
@use '../../../../styles/variables' as *;
@use '../../../../styles/mixins' as *;

.profile-page {
  @include flex-col;
  gap: $space-5;
  padding-bottom: $space-16;
}

// ── Header ─────────────────────────────────────────────────
.profile-header {
  @include flex-between;
  gap: $space-6;
  margin-bottom: $space-2;
  flex-wrap: wrap;
  align-items: flex-start;

  &__label {
    font-size: $font-size-xs;
    font-weight: $font-weight-semibold;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  &__title {
    font-size: $font-size-3xl;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
  }

  &__subtitle {
    font-size: $font-size-sm;
    color: var(--color-text-secondary);
    margin-top: $space-1;
  }

  &__nav {
    @include flex-start;
    gap: $space-2;
    flex-wrap: wrap;
  }
}

.profile-nav-btn {
  @include flex-start;
  gap: $space-2;
  padding: $space-2 $space-4;
  border: 1px solid var(--color-border);
  border-radius: $radius-pill;
  background: var(--color-bg-card);
  font-family: $font-family;
  font-size: $font-size-xs;
  font-weight: $font-weight-medium;
  color: var(--color-text-secondary);
  cursor: pointer;
  transition: all $transition-fast;

  .material-symbols-outlined {
    font-size: 15px;
  }

  &:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: var(--color-primary-light);
  }
}

// ── Section ────────────────────────────────────────────────
.profile-section {
  @include card($space-6);
  @include flex-col;
  gap: $space-5;
  scroll-margin-top: $space-6;

  &__header {
    @include flex-between;
    align-items: flex-start;
    gap: $space-4;
    padding-bottom: $space-4;
    border-bottom: 1px solid var(--color-border-light);
  }

  &__header-left {
    @include flex-start;
    gap: $space-4;
    align-items: flex-start;
  }

  &__icon {
    font-size: 22px;
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 2px;
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }

  &__title {
    font-size: $font-size-lg;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
  }

  &__subtitle {
    font-size: $font-size-sm;
    color: var(--color-text-muted);
    margin-top: 2px;
  }
}

// ── Avatar ─────────────────────────────────────────────────
.profile-avatar-row {
  @include flex-start;
  gap: $space-5;
  align-items: center;
}

.profile-avatar {
  position: relative;
  width: 80px;
  height: 80px;
  flex-shrink: 0;

  &__initials {
    width: 80px;
    height: 80px;
    border-radius: $radius-full;
    background: var(--color-primary);
    color: white;
    font-size: $font-size-2xl;
    font-weight: $font-weight-bold;
    @include flex-center;
    display: flex;
  }

  &__edit {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 28px;
    height: 28px;
    border-radius: $radius-full;
    background: var(--color-bg-card);
    border: 2px solid var(--color-border);
    @include flex-center;
    cursor: pointer;
    transition: all $transition-fast;

    .material-symbols-outlined {
      font-size: 14px;
      color: var(--color-text-muted);
    }

    &:hover {
      border-color: var(--color-primary);

      .material-symbols-outlined {
        color: var(--color-primary);
      }
    }
  }

  &__name {
    font-size: $font-size-lg;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
  }

  &__email {
    font-size: $font-size-sm;
    color: var(--color-text-muted);
    margin-top: 2px;
  }

  &__hint {
    font-size: $font-size-xs;
    color: var(--color-text-muted);
    margin-top: $space-1;
    font-style: italic;
  }
}

// ── Form Grid ──────────────────────────────────────────────
.profile-form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: $space-4;

  &--single {
    grid-template-columns: 1fr;
    max-width: 300px;
  }

  @include below-md {
    grid-template-columns: 1fr;
  }
}

// ── Preferences ────────────────────────────────────────────
.pref-row {
  @include flex-between;
  gap: $space-6;
  align-items: center;
  padding: $space-4 0;
  border-bottom: 1px solid var(--color-border-light);

  &:last-child {
    border-bottom: none;
  }

  &__info {
    @include flex-start;
    gap: $space-4;
    align-items: flex-start;
    flex: 1;
    min-width: 0;

    .material-symbols-outlined {
      font-size: 20px;
      color: var(--color-text-muted);
      flex-shrink: 0;
      margin-top: 2px;
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
    }
  }

  &__label {
    font-size: $font-size-sm;
    font-weight: $font-weight-semibold;
    color: var(--color-text-primary);
  }

  &__desc {
    font-size: $font-size-xs;
    color: var(--color-text-muted);
    margin-top: 2px;
    line-height: 1.5;
  }
}

.pref-theme-toggle {
  @include flex-start;
  border: 1px solid var(--color-border);
  border-radius: $radius-md;
  overflow: hidden;
  flex-shrink: 0;
}

.pref-theme-btn {
  @include flex-start;
  gap: $space-2;
  padding: $space-2 $space-3;
  border: none;
  border-right: 1px solid var(--color-border);
  background: none;
  font-family: $font-family;
  font-size: $font-size-xs;
  font-weight: $font-weight-medium;
  color: var(--color-text-muted);
  cursor: pointer;
  transition: all $transition-fast;
  white-space: nowrap;

  &:last-child {
    border-right: none;
  }

  .material-symbols-outlined {
    font-size: 15px;
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
  }

  &:hover:not(&--active) {
    background: var(--color-bg-hover);
    color: var(--color-text-primary);
  }

  &--active {
    background: var(--color-primary);
    color: white;

    .material-symbols-outlined {
      font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 20;
    }
  }
}

.pref-lang-toggle {
  @include flex-start;
  gap: $space-2;
  flex-shrink: 0;
}

.pref-lang-btn {
  @include flex-start;
  gap: $space-2;
  padding: $space-2 $space-4;
  border: 1px solid var(--color-border);
  border-radius: $radius-md;
  background: none;
  font-family: $font-family;
  font-size: $font-size-sm;
  font-weight: $font-weight-medium;
  color: var(--color-text-muted);
  cursor: pointer;
  transition: all $transition-fast;

  &:hover:not(&--active) {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  &--active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }
}

.pref-toggle {
  position: relative;
  display: inline-block;
  width: 44px;
  height: 24px;
  flex-shrink: 0;
  cursor: pointer;

  input {
    opacity: 0;
    width: 0;
    height: 0;

    &:checked+.pref-toggle__slider {
      background: var(--color-primary);

      &::before {
        transform: translateX(20px);
      }
    }
  }

  &__slider {
    position: absolute;
    inset: 0;
    background: var(--color-border);
    border-radius: $radius-pill;
    transition: background $transition-base;

    &::before {
      content: '';
      position: absolute;
      width: 18px;
      height: 18px;
      left: 3px;
      top: 3px;
      background: white;
      border-radius: $radius-full;
      transition: transform $transition-base;
      box-shadow: var(--shadow-sm);
    }
  }
}

// ── Subsection ─────────────────────────────────────────────
.profile-subsection {
  @include flex-col;
  gap: $space-4;
  padding: $space-5 0;
  border-top: 1px solid var(--color-border-light);

  &:first-of-type {
    border-top: none;
    padding-top: 0;
  }

  &__title {
    font-size: $font-size-base;
    font-weight: $font-weight-semibold;
    color: var(--color-text-primary);

    &--danger {
      color: var(--color-danger);
    }
  }

  &__action {
    @include flex-start;
  }

  &--danger {
    background: var(--color-danger-subtle);
    border-radius: $radius-md;
    padding: $space-4;
    border: 1px solid var(--color-danger-border);
    margin-top: $space-2;
  }
}

// ── Security Row ───────────────────────────────────────────
.security-row {
  @include flex-between;
  gap: $space-6;
  align-items: flex-start;
  flex-wrap: wrap;

  &__info {
    @include flex-start;
    gap: $space-4;
    align-items: flex-start;
    flex: 1;
    min-width: 0;
  }

  &__icon {
    font-size: 28px;
    flex-shrink: 0;
    margin-top: 2px;
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }

  &__label {
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    color: var(--color-text-primary);
  }

  &__desc {
    font-size: $font-size-xs;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-top: 2px;
  }
}

// ── Billing ────────────────────────────────────────────────
.billing-current {
  @include flex-start;
  gap: $space-4;
  align-items: center;
  padding: $space-4;
  background: var(--color-bg-input);
  border-radius: $radius-md;
  border: 1px solid var(--color-border);
  flex-wrap: wrap;

  &__badge {
    font-size: $font-size-sm;
    font-weight: $font-weight-bold;
    padding: $space-2 $space-4;
    border-radius: $radius-pill;
    background: var(--color-neutral-subtle);
    color: var(--color-neutral-text);
    border: 1px solid var(--color-neutral-border);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    flex-shrink: 0;
  }

  &__label {
    font-size: $font-size-sm;
    font-weight: $font-weight-semibold;
    color: var(--color-text-primary);
  }

  &__desc {
    font-size: $font-size-xs;
    color: var(--color-text-muted);
    margin-top: 2px;
  }
}

.billing-plans {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: $space-4;

  @include below-md {
    grid-template-columns: 1fr;
  }
}

.billing-card {
  @include flex-col;
  gap: $space-4;
  padding: $space-5;
  border: 2px solid var(--color-border);
  border-radius: $radius-lg;
  background: var(--color-bg-card);
  position: relative;
  transition: all $transition-base;

  &--active {
    border-color: var(--plan-color, var(--color-primary));
    background: var(--color-bg-input);
  }

  &--popular {
    border-color: var(--plan-color, var(--color-primary));
    box-shadow: var(--shadow-md);
  }

  &__badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--plan-color, var(--color-primary));
    color: white;
    font-size: 11px;
    font-weight: $font-weight-bold;
    padding: 3px $space-3;
    border-radius: $radius-pill;
    white-space: nowrap;
  }

  &__header {
    @include flex-col;
    gap: $space-2;
  }

  &__name {
    font-size: $font-size-lg;
    font-weight: $font-weight-bold;
  }

  &__price {
    @include flex-start;
    gap: $space-1;
    align-items: baseline;
  }

  &__amount {
    font-size: $font-size-2xl;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
  }

  &__period {
    font-size: $font-size-xs;
    color: var(--color-text-muted);
  }

  &__features {
    @include flex-col;
    gap: $space-2;
    list-style: none;
    padding: 0;
    margin: 0;
    flex: 1;

    li {
      @include flex-start;
      gap: $space-2;
      font-size: $font-size-xs;
      color: var(--color-text-secondary);

      .material-symbols-outlined {
        font-size: 15px;
        color: var(--color-primary);
        flex-shrink: 0;
        font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 20;
      }
    }
  }

  &__btn {
    width: 100%;
    padding: $space-3;
    border: none;
    border-radius: $radius-md;
    font-family: $font-family;
    font-size: $font-size-sm;
    font-weight: $font-weight-semibold;
    color: white;
    cursor: pointer;
    transition: all $transition-fast;
    margin-top: auto;

    &:hover:not(:disabled) {
      filter: brightness(1.1);
    }

    &--current {
      background: var(--color-bg-input) !important;
      color: var(--color-text-muted) !important;
      border: 1px solid var(--color-border) !important;
      cursor: not-allowed;
    }
  }
}

.billing-empty {
  @include flex-col;
  @include flex-center;
  gap: $space-3;
  padding: $space-8;
  background: var(--color-bg-input);
  border: 1px dashed var(--color-border);
  border-radius: $radius-md;
  text-align: center;

  .material-symbols-outlined {
    font-size: 40px;
    color: var(--color-text-muted);
    opacity: 0.4;
    font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 48;
  }

  p {
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    color: var(--color-text-secondary);
  }

  &__sub {
    font-size: $font-size-xs !important;
    color: var(--color-text-muted) !important;
    font-weight: 400 !important;
  }
}

// ── Save Bar ───────────────────────────────────────────────
.profile-save-bar {
  position: fixed;
  bottom: $space-6;
  left: 50%;
  transform: translateX(-50%);
  @include flex-between;
  gap: $space-6;
  align-items: center;
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: $radius-xl;
  padding: $space-4 $space-6;
  box-shadow: var(--shadow-lg);
  z-index: 100;
  min-width: 420px;
  animation: slide-up 0.2s ease-out;

  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(12px);
    }

    to {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  }

  &__text {
    @include flex-start;
    gap: $space-2;
    font-size: $font-size-sm;
    color: var(--color-text-secondary);

    .material-symbols-outlined {
      font-size: 16px;
      color: var(--color-primary);
    }
  }

  &__actions {
    @include flex-start;
    gap: $space-3;
  }
}

// ── Modal ──────────────────────────────────────────────────
.modal-overlay {
  position: fixed;
  inset: 0;
  background: var(--color-overlay);
  backdrop-filter: blur(4px);
  z-index: 200;
  @include flex-center;
  padding: $space-4;
}

.confirm-dialog {
  background: var(--color-bg-card);
  border-radius: $radius-xl;
  box-shadow: var(--shadow-lg);
  width: 100%;
  max-width: 440px;
  padding: $space-8;
  @include flex-col;
  align-items: center;
  text-align: center;
  gap: $space-4;

  &__icon {
    width: 60px;
    height: 60px;
    border-radius: $radius-full;
    @include flex-center;

    .material-symbols-outlined {
      font-size: 30px;
      font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    &--danger {
      background: var(--color-danger-subtle);
      color: var(--color-danger);
    }
  }

  &__title {
    font-size: $font-size-xl;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
  }

  &__text {
    font-size: $font-size-sm;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  &__actions {
    @include flex-center;
    gap: $space-3;
    margin-top: $space-2;
  }
}

.btn-danger {
  @include btn-base;
  background: var(--color-danger);
  color: white;

  &:hover:not(:disabled) {
    background: var(--color-danger-hover);
  }
}
</file>

<file path="src/app/pages/workspace/profile/profile.ts">
import { Component, signal } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { Router, ActivatedRoute } from '@angular/router';

type ColorTheme = 'LIGHT' | 'DARK' | 'SYSTEM';
type Language = 'DE' | 'EN';

@Component({
  selector: 'app-profile',
  imports: [CommonModule, FormsModule],
  templateUrl: './profile.html',
  styleUrl: './profile.scss',
})
export class ProfileComponent {
  hasChanges = signal(false);
  showDeleteConfirm = signal(false);

  // Profile
  firstname = signal('Felix');
  lastname = signal('Müller');
  email = signal('felix@easylife.app');
  bio = signal(
    'Building Easy Life - a productivity suite for intentional people. Passionate about deep work, systems thinking and great software.',
  );
  readonly bioMaxLength = 240;

  // Address
  country = signal('Germany');
  street = signal('Musterstraße');
  number = signal('42');
  additionalInfo = signal('');
  zipCode = signal('40210');
  city = signal('Düsseldorf');

  // Preferences
  webColorTheme = signal<ColorTheme>('LIGHT');
  mobileColorTheme = signal<ColorTheme>('SYSTEM');
  language = signal<Language>('EN');
  emailNotifications = signal(true);
  pushNotifications = signal(false);

  // Security
  currentPassword = signal('');
  newPassword = signal('');
  confirmPassword = signal('');
  twoFactorEnabled = signal(false);
  sessionTimeout = signal('30');

  // Billing
  readonly currentPlan = signal<'FREE' | 'PLUS' | 'PRO'>('FREE');

  readonly sessionTimeoutOptions = [
    { value: '15', label: '15 minutes' },
    { value: '30', label: '30 minutes' },
    { value: '60', label: '1 hour' },
    { value: '240', label: '4 hours' },
    { value: 'never', label: 'Never' },
  ];

  readonly themes: { value: ColorTheme; label: string; icon: string }[] = [
    { value: 'LIGHT', label: 'Light', icon: 'light_mode' },
    { value: 'DARK', label: 'Dark', icon: 'dark_mode' },
    { value: 'SYSTEM', label: 'System', icon: 'brightness_auto' },
  ];

  readonly languages: { value: Language; label: string; flag: string }[] = [
    { value: 'EN', label: 'English', flag: '🇬🇧' },
    { value: 'DE', label: 'Deutsch', flag: '🇩🇪' },
  ];

  readonly plans = [
    {
      id: 'FREE',
      label: 'Free',
      price: '0€',
      period: 'forever',
      features: ['50 Tasks', '10 Categories', '5 Goals', '500 MB Storage', 'No AI Agent'],
      color: '#757575',
      popular: false,
    },
    {
      id: 'PLUS',
      label: 'Plus',
      price: '7.99€',
      period: '/month',
      features: [
        'Unlimited Tasks',
        'Unlimited Categories',
        'Unlimited Goals',
        '10 GB Storage',
        'Basic AI Agent',
        'Network & Following',
      ],
      color: '#1976d2',
      popular: true,
    },
    {
      id: 'PRO',
      label: 'Pro',
      price: '14.99€',
      period: '/month',
      features: [
        'Everything in Plus',
        '50 GB Storage',
        'Full AI Agent',
        'Priority Support',
        'Early Access Features',
      ],
      color: '#9c27b0',
      popular: false,
    },
  ];

  constructor(
    private router: Router,
    private route: ActivatedRoute,
  ) {}

  getInitials(): string {
    return `${this.firstname().charAt(0)}${this.lastname().charAt(0)}`.toUpperCase();
  }

  markChanged() {
    this.hasChanges.set(true);
  }

  onSave() {
    console.log('Save profile');
    this.hasChanges.set(false);
  }

  onDiscard() {
    this.hasChanges.set(false);
  }

  scrollToSection(sectionId: string) {
    setTimeout(() => {
      const el = document.getElementById(sectionId);
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 100);
  }
}
