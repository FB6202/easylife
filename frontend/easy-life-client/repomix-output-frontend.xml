<file path="src/app/pages/workspace/journal/journal.scss">
@use '../../../../styles/variables' as *;
@use '../../../../styles/mixins' as *;

// ── Header ─────────────────────────────────────────────────
.journal-header {
  @include flex-between;
  margin-bottom: $space-6;
  gap: $space-4;
  flex-wrap: wrap;

  &__text {
    @include flex-col;
    gap: $space-1;
  }

  &__label {
    font-size: $font-size-xs;
    font-weight: $font-weight-semibold;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  &__subtitle {
    font-size: $font-size-sm;
    color: var(--color-text-secondary);
    max-width: 460px;
  }

  &__actions {
    @include flex-start;
    gap: $space-3;
  }
}

.btn-secondary--active {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: var(--color-primary-light);
}

.filter-active-badge {
  background: var(--color-primary);
  color: white;
  font-size: 11px;
  font-weight: $font-weight-bold;
  padding: 1px 6px;
  border-radius: $radius-pill;
  margin-left: $space-1;
  min-width: 18px;
  text-align: center;
}

// ── Container ──────────────────────────────────────────────
.journal-container {
  @include flex-col;
  gap: $space-4;
}

// ── Journal Card ───────────────────────────────────────────
.journal-card {
  @include card($space-6);
  display: grid;
  grid-template-columns: 100px 1fr;
  gap: $space-6;
  cursor: pointer;
  transition: box-shadow $transition-base, transform $transition-base;

  &:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  @include below-md {
    grid-template-columns: 1fr;
  }
}

.journal-card__aside {
  @include flex-col;
  align-items: center;
  gap: $space-4;
  padding-right: $space-6;
  border-right: 1px solid var(--color-border-light);

  @include below-md {
    flex-direction: row;
    border-right: none;
    border-bottom: 1px solid var(--color-border-light);
    padding-right: 0;
    padding-bottom: $space-4;
  }
}

.journal-card__date {
  @include flex-col;
  align-items: center;
  text-align: center;
  gap: 2px;
}

.journal-card__day {
  font-size: $font-size-4xl;
  font-weight: $font-weight-bold;
  color: var(--color-primary);
  line-height: 1;
}

.journal-card__month {
  font-size: $font-size-xs;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  white-space: nowrap;
}

.journal-card__mood {
  @include flex-col;
  align-items: center;
  gap: $space-1;
  padding: $space-2 $space-3;
  border-radius: $radius-md;
  text-align: center;

  .material-symbols-outlined {
    font-size: 26px;
    font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }
}

.journal-card__mood-label {
  font-size: $font-size-xs;
  font-weight: $font-weight-semibold;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.journal-card__content {
  @include flex-col;
  gap: $space-4;
  min-width: 0;
}

.journal-card__top {
  @include flex-between;
  gap: $space-4;
  flex-wrap: wrap;
  align-items: flex-start;
}

.journal-card__title {
  font-size: $font-size-lg;
  font-weight: $font-weight-bold;
  color: var(--color-text-primary);
  flex: 1;
  min-width: 0;
}

.journal-card__badges {
  @include flex-start;
  gap: $space-2;
  flex-wrap: wrap;
  flex-shrink: 0;
}

.journal-badge {
  @include flex-start;
  gap: $space-1;
  font-size: $font-size-xs;
  font-weight: $font-weight-semibold;
  padding: 3px $space-3;
  border-radius: $radius-pill;
  white-space: nowrap;

  .material-symbols-outlined {
    font-size: 13px;
    font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 20;
  }

  &--learnings {
    background: var(--color-info-subtle);
    color: var(--color-info-text);
    border: 1px solid var(--color-info-border);
  }

  &--gratitude {
    background: var(--color-pink-subtle);
    color: var(--color-pink-text);
    border: 1px solid var(--color-pink-border);
  }

  &--weekplan {
    background: var(--color-success-subtle);
    color: var(--color-primary);
    border: 1px solid var(--color-success-border);
    max-width: 180px;
    @include truncate;
  }
}

.journal-card__sections {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: $space-4;

  @include below-md {
    grid-template-columns: 1fr;
  }
}

.journal-section {
  @include flex-col;
  gap: $space-2;
  padding: $space-4;
  border-radius: $radius-md;

  &--well {
    background: var(--color-success-subtle);
    border: 1px solid var(--color-success-border);
  }

  &--bad {
    background: var(--color-danger-subtle);
    border: 1px solid var(--color-danger-border);
  }

  &__header {
    @include flex-start;
    gap: $space-2;
    font-size: $font-size-xs;
    font-weight: $font-weight-bold;
    letter-spacing: 0.06em;
    text-transform: uppercase;

    .material-symbols-outlined {
      font-size: 14px;
    }
  }

  &--well &__header {
    color: var(--color-success-text);
  }

  &--bad &__header {
    color: var(--color-danger-text);
  }

  &__text {
    font-size: $font-size-xs;
    color: var(--color-text-secondary);
    line-height: 1.6;
    @include truncate(3);
  }
}

.journal-card__footer {
  @include flex-between;
  padding-top: $space-3;
  border-top: 1px solid var(--color-border-light);
  flex-wrap: wrap;
  gap: $space-3;
}

.journal-card__cats {
  @include flex-start;
  gap: $space-2;
}

.journal-card__cat-icon {
  font-size: 18px;
  font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
}

.journal-card__meta {
  @include flex-start;
  gap: $space-2;
  font-size: $font-size-xs;
  color: var(--color-text-muted);

  .material-symbols-outlined {
    font-size: 14px;
  }
}

.journal-pagination {
  @include card(0);
  overflow: hidden;
}

// ══ MODAL OVERLAY ════════════════════════════════════════
.modal-overlay {
  position: fixed;
  inset: 0;
  background: var(--color-overlay);
  backdrop-filter: blur(4px);
  z-index: 200;
  @include flex-center;
  padding: $space-4;
}

// ══ JOURNAL MODAL ════════════════════════════════════════
.journal-modal {
  background: var(--color-bg-card);
  border-radius: $radius-xl;
  box-shadow: var(--shadow-lg);
  width: 100%;
  max-width: 600px;
  max-height: 90vh;
  overflow-y: auto;
  @include scrollbar-thin;
  @include flex-col;
  gap: $space-5;
  padding: $space-8;

  &__header {
    @include flex-between;
    align-items: flex-start;
    gap: $space-4;
  }

  &__header-actions {
    @include flex-start;
    gap: $space-2;
  }

  &__title {
    font-size: $font-size-xl;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
  }

  &__subtitle {
    font-size: $font-size-sm;
    color: var(--color-text-muted);
    margin-top: 2px;
  }

  &__close {
    @include btn-ghost;
    border-radius: $radius-md;
    padding: $space-1;
    flex-shrink: 0;

    .material-symbols-outlined {
      font-size: 22px;
    }
  }

  &__action-btn {
    width: 36px;
    height: 36px;
    border-radius: $radius-md;
    border: none;
    @include flex-center;
    cursor: pointer;
    transition: all $transition-fast;

    .material-symbols-outlined {
      font-size: 18px;
    }

    &--delete {
      background: var(--color-danger-subtle);
      color: var(--color-danger);

      &:hover {
        background: var(--color-danger-subtle);
        filter: brightness(0.9);
      }
    }
  }

  &__title-input {
    width: 100%;
    border: none;
    border-bottom: 2px solid var(--color-border);
    padding: $space-2 0;
    font-family: $font-family;
    font-size: $font-size-xl;
    font-weight: $font-weight-semibold;
    color: var(--color-text-primary);
    background: transparent;
    outline: none;
    transition: border-color $transition-fast;

    &::placeholder {
      color: var(--color-text-muted);
    }

    &:focus {
      border-color: var(--color-primary);
    }
  }

  &__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: $space-4;

    @include below-md {
      grid-template-columns: 1fr;
    }
  }

  &__section-label {
    @include flex-start;
    gap: $space-2;
    font-size: $font-size-sm;
    font-weight: $font-weight-semibold;
    margin-bottom: $space-1;

    .material-symbols-outlined {
      font-size: 16px;
    }

    &--well {
      color: var(--color-success-text);
    }

    &--bad {
      color: var(--color-danger-text);
    }

    &--learnings {
      color: var(--color-info-text);
    }

    &--gratitude {
      color: var(--color-pink-text);
    }
  }

  &__weekplan-current {
    @include flex-start;
    gap: $space-2;
    padding: $space-2 $space-3;
    background: var(--color-success-subtle);
    border: 1px solid var(--color-success-border);
    border-radius: $radius-md;
    font-size: $font-size-xs;
    color: var(--color-primary);
    margin-bottom: $space-2;

    .material-symbols-outlined {
      font-size: 15px;
      flex-shrink: 0;
    }
  }

  &__weekplan-dates {
    color: var(--color-text-muted);
    margin-left: $space-1;
  }

  &__footer {
    @include flex-between;
    padding-top: $space-4;
    border-top: 1px solid var(--color-border-light);
  }
}

// ── Mood Picker ────────────────────────────────────────────
.mood-picker {
  @include flex-start;
  gap: $space-2;
}

.mood-btn {
  width: 40px;
  height: 40px;
  border-radius: $radius-md;
  border: 1px solid var(--color-border);
  background: var(--color-bg-card);
  @include flex-center;
  cursor: pointer;
  transition: all $transition-fast;

  .material-symbols-outlined {
    font-size: 22px;
    font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }

  &:hover {
    border-color: var(--mood-color, var(--color-primary));
    background: var(--color-bg-hover);
    transform: scale(1.1);
  }

  &--active {
    background: var(--mood-color, var(--color-primary));
    border-color: var(--mood-color, var(--color-primary));
    transform: scale(1.1);
    box-shadow: var(--shadow-sm);
  }
}

// ── Form Group Label Override ──────────────────────────────
.journal-modal {
  .form-group label:not(.journal-modal__section-label) {
    @include flex-start;
    gap: $space-2;
    align-items: center;

    .material-symbols-outlined {
      font-size: 15px;
      color: var(--color-primary);
      flex-shrink: 0;
    }
  }
}

// ══ CONFIRM DIALOG ════════════════════════════════════════
.confirm-dialog {
  background: var(--color-bg-card);
  border-radius: $radius-xl;
  box-shadow: var(--shadow-lg);
  width: 100%;
  max-width: 420px;
  padding: $space-8;
  @include flex-col;
  align-items: center;
  text-align: center;
  gap: $space-4;

  &__icon {
    width: 56px;
    height: 56px;
    border-radius: $radius-full;
    @include flex-center;

    .material-symbols-outlined {
      font-size: 28px;
      font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    &--danger {
      background: var(--color-danger-subtle);
      color: var(--color-danger);
    }
  }

  &__title {
    font-size: $font-size-xl;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
  }

  &__text {
    font-size: $font-size-sm;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  &__actions {
    @include flex-center;
    gap: $space-3;
    margin-top: $space-2;
  }
}

.btn-danger {
  @include btn-base;
  background: var(--color-danger);
  color: white;

  &:hover:not(:disabled) {
    background: var(--color-danger-hover);
  }
}
