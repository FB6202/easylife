        <div class="dash-journal-item__info">
          <span class="dash-journal-item__title">{{ entry.title }}</span>
          <span class="dash-journal-item__meta">
            {{ entry.date }} · {{ entry.wordCount }} words
          </span>
        </div>
      </div>
      }
    </div>
  </div>
  }

  <!-- People Widget -->
  @if (isWidgetEnabled('network')) {
  <div class="dash-widget dash-widget--network" (click)="navigateTo('network')">
    <div class="dash-widget__header">
      <div class="dash-widget__header-left">
