      <textarea rows="3" placeholder="What positive things happened today?"
        [(ngModel)]="createForm().wentWell"></textarea>
    </div>

    <div class="form-group">
      <label class="journal-modal__section-label journal-modal__section-label--bad">
        <span class="material-symbols-outlined">trending_down</span>What didn't go well?
