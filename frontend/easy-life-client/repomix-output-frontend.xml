    }
  }

  &__subtitle {
    font-size: $font-size-lg;
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 480px;
  }
}

// ── Toggle ─────────────────────────────────────────────────
.pricing-toggle {
  @include flex-start;
  gap: $space-3;
  font-size: $font-size-sm;
  font-weight: $font-weight-medium;
  color: var(--color-text-muted);

  span.active {
    color: var(--color-text-primary);
  }

  &__btn {
    width: 48px;
    height: 26px;
    border-radius: $radius-pill;
    background: var(--color-border);
    border: none;
    position: relative;
    cursor: pointer;
    transition: background $transition-base;

    &.yearly {
      background: var(--color-primary);
    }
  }

  &__thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    border-radius: $radius-full;
    background: white;
    transition: transform $transition-base;
    box-shadow: var(--shadow-sm);

    .yearly & {
      transform: translateX(22px);
    }
  }

  &__save {
    display: inline-flex;
    align-items: center;
    margin-left: $space-2;
    padding: 2px $space-2;
    border-radius: $radius-pill;
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-size: $font-size-xs;
    font-weight: $font-weight-semibold;
  }
}

// ── Grid ───────────────────────────────────────────────────
.pricing-grid {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 $space-6;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: $space-5;
  align-items: start;

  @include below-lg {
    grid-template-columns: 1fr;
    max-width: 480px;
  }
}

// ── Plan Card ──────────────────────────────────────────────
.plan-card {
  @include card($space-8);
  @include flex-col;
  gap: $space-5;
  position: relative;
  transition:
    box-shadow $transition-base,
    transform $transition-base;

  &:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  &--highlighted {
    border-color: var(--color-primary);
    border-width: 2px;
    box-shadow: 0 8px 32px rgba(67, 160, 71, 0.15);
    transform: translateY(-8px);

    &:hover {
      transform: translateY(-10px);
      box-shadow: 0 12px 40px rgba(67, 160, 71, 0.2);
    }
  }

  &__badge {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: white;
    font-size: $font-size-xs;
    font-weight: $font-weight-bold;
    padding: $space-1 $space-4;
    border-radius: $radius-pill;
    white-space: nowrap;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  &__header {
    @include flex-col;
    gap: $space-2;
  }

  &__name {
    font-size: $font-size-xl;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
  }

  &__desc {
    font-size: $font-size-sm;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  &__price {
    @include flex-start;
    gap: 2px;
    align-items: flex-end;
    flex-wrap: wrap;
  }

  &__currency {
    font-size: $font-size-lg;
    font-weight: $font-weight-semibold;
    color: var(--color-text-primary);
    margin-bottom: 4px;
  }

  &__amount {
    font-size: $font-size-4xl;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
    line-height: 1;
  }

  &__period {
    font-size: $font-size-sm;
    color: var(--color-text-muted);
    margin-bottom: 6px;
  }

  &__billed {
    width: 100%;
    font-size: $font-size-xs;
    color: var(--color-text-muted);
    margin-top: 2px;
  }

  &__cta {
    justify-content: center;
    padding: $space-3 !important;
    font-size: $font-size-sm !important;
    border-radius: $radius-md !important;
  }

  &__divider {
    width: 100%;
    height: 1px;
    background: var(--color-border-light);
  }

  &__features {
    @include flex-col;
    gap: $space-3;
  }
}

// ── Feature Item ───────────────────────────────────────────
.plan-feature {
  @include flex-start;
  gap: $space-3;

  &__icon {
    font-size: 18px;
    color: var(--color-primary);
    font-variation-settings:
      'FILL' 1,
      'wght' 400,
      'GRAD' 0,
      'opsz' 20;
    flex-shrink: 0;
  }

  &__text {
    font-size: $font-size-sm;
    color: var(--color-text-primary);
  }

  &--disabled {
    .plan-feature__icon {
      color: var(--color-text-muted);
      font-variation-settings:
        'FILL' 0,
        'wght' 400,
        'GRAD' 0,
        'opsz' 20;
    }

    .plan-feature__text {
      color: var(--color-text-muted);
      text-decoration: line-through;
    }
  }
}

// ── FAQ ────────────────────────────────────────────────────
.pricing-faq {
  max-width: 900px;
  margin: $space-16 auto 0;
  padding: 0 $space-6;

  &__title {
    font-size: $font-size-2xl;
    font-weight: $font-weight-bold;
    color: var(--color-text-primary);
    text-align: center;
    margin-bottom: $space-10;
  }

  &__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: $space-6;

    @include below-md {
      grid-template-columns: 1fr;
    }
  }
}

.faq-item {
  @include card($space-6);
  @include flex-col;
  gap: $space-3;
  transition: box-shadow $transition-base;

  &:hover {
    box-shadow: var(--shadow-md);
  }

  &__icon {
    width: 40px;
    height: 40px;
    border-radius: $radius-md;
    background: var(--color-primary-light);
    @include flex-center;
    flex-shrink: 0;

    .material-symbols-outlined {
      font-size: 20px;
      color: var(--color-primary);
      font-variation-settings:
        'FILL' 0,
        'wght' 400,
        'GRAD' 0,
        'opsz' 24;
    }
  }

  &__q {
    font-size: $font-size-base;
    font-weight: $font-weight-semibold;
    color: var(--color-text-primary);
  }

  &__a {
    font-size: $font-size-sm;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }
}
</file>

