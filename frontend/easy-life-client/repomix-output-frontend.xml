      <textarea rows="3" placeholder="What challenges did you face?" [(ngModel)]="createForm().wentBad"></textarea>
    </div>

    <div class="form-group">
      <label class="journal-modal__section-label journal-modal__section-label--learnings">
        <span class="material-symbols-outlined">lightbulb</span>
        Learnings <span class="form-group__optional">optional</span>
      </label>
      <textarea rows="2" placeholder="What did you learn today?" [(ngModel)]="createForm().learnings"></textarea>
    </div>

    <div class="form-group">
      <label class="journal-modal__section-label journal-modal__section-label--gratitude">
        <span class="material-symbols-outlined">favorite</span>
        Gratitude <span class="form-group__optional">optional</span>
      </label>
      <textarea rows="2" placeholder="What are you grateful for today?" [(ngModel)]="createForm().gratitude"></textarea>
    </div>

    <div class="form-group">
      <label>
        <span class="material-symbols-outlined" style="font-size: 15px; color: var(--color-primary)">view_week</span>
        Link to Week Plan <span class="form-group__optional">optional</span>
      </label>
      <select [(ngModel)]="createForm().weekPlanId">
        <option [ngValue]="null">No week plan</option>
        @for (plan of availableWeekPlans(); track plan.id) {
        <option [ngValue]="plan.id">{{ plan.title }} ({{ plan.startDate }} – {{ plan.endDate }})</option>
        }
      </select>
    </div>

    <!-- Categories Dropdown -->
    <div class="form-group" (click)="$event.stopPropagation()">
      <label>Categories</label>
      <div class="modal-cat-dropdown">
        <button class="modal-cat-dropdown__trigger"
          [class.modal-cat-dropdown__trigger--active]="createForm().categoryIds.length > 0"
          [class.modal-cat-dropdown__trigger--open]="showCatDropdown()" (click)="toggleCatDropdown($event)">
          <div class="modal-cat-dropdown__trigger-left">
            @if (createForm().categoryIds.length > 0) {
            <div class="modal-cat-dropdown__dots">
              @for (color of getSelectedCatColors(createForm().categoryIds); track color) {
              <span class="modal-cat-dropdown__dot" [style.background]="color"></span>
              }
            </div>
            }
            <span class="modal-cat-dropdown__label">
              {{ getCatDropdownLabel(createForm().categoryIds) }}
            </span>
          </div>
          <span class="material-symbols-outlined modal-cat-dropdown__arrow">
            {{ showCatDropdown() ? 'expand_less' : 'expand_more' }}
          </span>
        </button>
        @if (showCatDropdown()) {
        <div class="modal-cat-dropdown__menu">
          @for (cat of availableCategories(); track cat.id) {
          <button class="modal-cat-dropdown__item"
            [class.modal-cat-dropdown__item--selected]="createForm().categoryIds.includes(cat.id)"
            (click)="toggleCreateCategory(cat.id)">
            <div class="modal-cat-dropdown__item-check">
              @if (createForm().categoryIds.includes(cat.id)) {
              <span class="material-symbols-outlined">check</span>
              }
            </div>
            <span class="material-symbols-outlined modal-cat-dropdown__item-icon" [style.color]="cat.color">{{ cat.icon
              }}</span>
            <span class="modal-cat-dropdown__item-label">{{ cat.name }}</span>
          </button>
          }
          @if (createForm().categoryIds.length > 0) {
          <div class="modal-cat-dropdown__footer">
            <button class="modal-cat-dropdown__clear"
              (click)="createForm.update(f => ({ ...f, categoryIds: [] })); $event.stopPropagation()">
              <span class="material-symbols-outlined">close</span>Clear
            </button>
          </div>
          }
        </div>
        }
      </div>
    </div>

    <div class="journal-modal__footer">
      <button class="btn-secondary" (click)="showCreateModal.set(false)">Cancel</button>
      <button class="btn-primary" (click)="submitCreate()">Save Entry</button>
    </div>
  </div>
</div>
}

<!-- ══ EDIT MODAL ════════════════════════════════════════ -->
@if (showEditModal() && selectedEntry()) {
