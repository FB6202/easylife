  readonly referenceTypeOptions: { value: ReferenceType; label: string; icon: string }[] = [
    { value: 'TODO', label: 'Task', icon: 'check_circle' },
    { value: 'GOAL', label: 'Goal', icon: 'flag' },
    { value: 'EVENT', label: 'Calendar Event', icon: 'event' },
